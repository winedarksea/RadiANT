 # Remote wakeup off, matching a retail stick. See the Feather's conf for why
 # this cannot live in prj.conf or be expressed as a Kconfig default.
 CONFIG_USB_DEVICE_REMOTE_WAKEUP=n
+
+# Most of these boards have no RESET button, so without this every reflash
+# means shorting RST to GND twice. Asserted on both Pro Micro rows in
+# release.yml and scripts/build_all.ps1. See the Kconfig help for the
+# trade-off.
+CONFIG_ANT_DONGLE_UF2_REBOOT_REQUEST=y
diff --git a/apps/dongle/uf2_reboot.conf b/apps/dongle/uf2_reboot.conf
new file mode 100644
index 0000000..e0dae06
--- /dev/null
+++ b/apps/dongle/uf2_reboot.conf
@@ -0,0 +1,11 @@
+# Let the host reboot the board into its UF2 bootloader over USB, so it can be
+# reflashed with no physical access. See CONFIG_ANT_DONGLE_UF2_REBOOT_REQUEST.
+#
+# The Pro Micro images already have this in their board conf. This fragment is
+# the opt-in for other boards.
+#
+# Usage:
+#   west build ... -b adafruit_feather_nrf52840/nrf52840/uf2 -- "-DEXTRA_CONF_FILE=uf2_reboot.conf"
+#   python tools/ant_probe.py --reboot-to-bootloader
+
+CONFIG_ANT_DONGLE_UF2_REBOOT_REQUEST=y
