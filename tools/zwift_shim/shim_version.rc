/* SPDX-License-Identifier: Apache-2.0
 *
 * VERSIONINFO for both shim DLLs; SHIM_XP selects the USBXpress one. The
 * installer identifies "ours" by ProductName (see shim_version.h).
 */
#include <winver.h>
#include "shim_version.h"

#ifdef SHIM_XP
#define SHIM_ORIGINAL "DSI_SiUSBXp_3_1.DLL"
#define SHIM_DESC     "RadiANT USBXpress transport shim for Zwift's ANT_DLL (COM port)"
#else
#define SHIM_ORIGINAL "DSI_CP210xManufacturing_3_1.dll"
#define SHIM_DESC     "RadiANT CP210x identity shim for Zwift's ANT_DLL"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SHIM_VERSION_BIN
 PRODUCTVERSION SHIM_VERSION_BIN
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RadiANT (built locally; not a Silicon Labs file)"
            VALUE "FileDescription",  SHIM_DESC
            VALUE "FileVersion",      SHIM_VERSION_STR
            VALUE "InternalName",     "radiant-zwift-shim"
            VALUE "OriginalFilename", SHIM_ORIGINAL
            VALUE "ProductName",      SHIM_PRODUCT_NAME
            VALUE "ProductVersion",   SHIM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
