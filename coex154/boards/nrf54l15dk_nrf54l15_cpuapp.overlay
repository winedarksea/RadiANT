/*
 * nRF54L15 DK - the P3.5 DUT.
 *
 * Only what radiant_core's nrf backend needs. This application has no ANT
 * serial transport and no host: it is a frame counter that prints, so uart20's
 * default console is the whole interface.
 *
 * ---------------------------------------------------------------------------
 * THE TIMER COLLISION THE PLAN ASKED TO CHECK BEFORE ANYTHING ELSE, CHECKED
 * ---------------------------------------------------------------------------
 *
 * The multiprotocol plan flags one hardware conflict as the first thing to
 * settle on nRF54L in this branch: the 802.15.4 driver's own timer instance is
 * TIMER10 (nrf_802154_peripherals_nrf54l.h), which is also the instance MPSL
 * hands to timeslot users as MPSL_TIMER0. That is a real third claim on one
 * instance - but it is NOT a claim on this one.
 *
 * radiant_core takes timer20, and timer20 alone, and it takes it outright
 * rather than through MPSL: the backend runs it at 1 MHz continuously and
 * hardware-captures t_sync into it from RADIO's ADDRESS event, so it cannot be
 * an arbitrated resource even in principle. The two do not overlap, and the
 * plan's TIMER audit can record that as settled for this pairing. What remains
 * arbitrated between the gate and the 15.4 driver is TIMER10 and the RADIO,
 * which is exactly the contention P3.5 is here to measure.
 */

/ {
	chosen {
		radiant,radio-timer = &timer20;
	};
};

&timer20 {
	status = "okay";
};
