#
# radiant_core - an independent link layer compatible with the ANT+
# specifications. Not ANT, not Garmin's, and named so that nothing about the
# build surface reads as a claim to be either.

config RADIANT_CORE
	bool "radiant_core ANT-compatible link layer"
	help
	  Build radiant_core: the frame codec, the radio schedule, the channel
	  state machines, the search policy, the event queue and the
	  acknowledged/burst transfer engine.

	  This is the module the application selects with -DANT_RADIO=core. It
	  contains no Nordic sdk-ant code and links no libant.a; an sdk_ant
	  build leaves this symbol at n, and that n is the positive assertion
	  that the clean-room boundary held.

if RADIANT_CORE

module = RADIANT_CORE
module-str = radiant_core
source "subsys/logging/Kconfig.template.log_config"

choice RADIANT_CORE_BACKEND
	prompt "radiant_core radio backend"
	default RADIANT_CORE_BACKEND_NULL
	help
	  radiant_core decides what goes on the air and when; a backend decides
	  how. include/radiant_core/radiant_radio_hal.h is the whole of that
	  boundary and its eight entry points are what a backend supplies.

	  A backend REPLACES the others rather than joining them: two
	  definitions of radiant_radio_now() is a duplicate-symbol link error,
	  which is the right way for that mistake to be found.

config RADIANT_CORE_BACKEND_NULL
	bool "null - real lifecycle and clock, refuses every arm"
	help
	  src/radiant_radio_null.c. The lifecycle and the clock are real and
	  every arm call is refused with RADIANT_RADIO_ENOTSUP. The HAL-level
	  counterpart of src/ant_radio_stub.c: the image enumerates, answers the
	  host, runs the scheduler, the search policy, the channel state
	  machines and the event queue, and finds no sensors.

	  This is the honest default while no real backend exists.

config RADIANT_CORE_BACKEND_NONE
	bool "none - the application supplies the HAL"
	help
	  The module compiles no backend at all and the eight HAL entry points
	  are left undefined for the surrounding application to define. This is
	  what the unit-test application selects: tests/fake_radio.c is a
	  complete HAL implementation with a virtual clock, and it belongs in a
	  test image and nowhere near a dongle.

config RADIANT_CORE_BACKEND_NRF
	bool "nrf - direct nRF RADIO peripheral"
	#
	# SOC_COMPATIBLE_*, NOT SOC_SERIES_*, and the difference is a whole
	# session. NCS v3.4.0 ships Zephyr 4.4, which renamed SOC_SERIES_NRF52X
	# to SOC_SERIES_NRF52 and SOC_SERIES_NRF54LX to SOC_SERIES_NRF54L. The
	# old names still EXIST as symbols in that tree, so nothing errors -
	# they are simply never set, this dependency is silently unmet, and
	# Kconfig falls back to the choice default. The result is a build that
	# accepted -DRADIANT_BACKEND=nrf, printed no error, and compiled the
	# null backend: an image that enumerates, answers the host, runs every
	# state machine and finds no sensors, which is indistinguishable from a
	# radio problem.
	#
	# The SOC_COMPATIBLE_ symbols are set in BOTH v3.2.4 and v3.4.0 and are
	# the ones meant for exactly this - "this part behaves like that family"
	# - rather than "this part is in that Kconfig directory". The C file
	# tests the same pair.
	#
	depends on SOC_COMPATIBLE_NRF52X || SOC_COMPATIBLE_NRF54LX
	# `!BT` used to be here unconditionally, because this backend owned the
	# RADIO and a Bluetooth controller would have reprogrammed it underneath
	# us. Whether it owns the RADIO is now the gate's answer (see
	# RADIANT_CORE_BACKEND_NRF_GATE_MPSL below), so the exclusion is
	# conditional on the gate instead of absolute. The C file carries the
	# same test as a BUILD_ASSERT, so a configuration that reached here by
	# another route still fails loudly rather than losing packets quietly.
	depends on !BT || RADIANT_CORE_BACKEND_NRF_GATE_MPSL
	select CLOCK_CONTROL
	select NRFX_GPPI
	help
	  src/radiant_radio_nrf.c: the RADIO, one TIMER and four (D)PPI
	  channels, owned outright. Receive and transmit.

	  The TIMER named by the radiant,radio-timer chosen node must have at
	  least five CC channels - t_sync capture, RX start, window close,
	  software now-capture and TX start. Receive-start and transmit-start
	  cannot share a compare, because a DPPI event may publish to only one
	  channel. On nRF52 that means TIMER3 or TIMER4.

	  The address arithmetic and packet configuration are measured on
	  nRF54L15 (Spike A). The nRF52840 is predicted to behave identically
	  and has not been confirmed. The ramp-up and turnaround figures are
	  from the datasheet, and the two t_sync calibration constants are
	  seeded from Zephyr's per-SoC BLE chain delays rather than measured on
	  this bench - see the warnings at the top of the file.

config RADIANT_CORE_BACKEND_CC26XX
	bool "cc26xx - TI CC13x2/CC26x2 RF core, proprietary mode"
	#
	# READ THE NOTE ON THE nrf ARM ABOVE BEFORE CHANGING THIS LINE, because
	# this is the same trap with the mitigation deliberately weakened.
	#
	# There is no SOC_COMPATIBLE_* symbol for any TI part. Zephyr defines
	# that family of symbols for Nordic and for a handful of others; TI's
	# tree has SOC_SERIES_CC13X2_CC26X2 and nothing else, so the construct
	# that a rename silently breaks is the ONLY construct available. That
	# has cost this project four sessions across three mechanisms, and the
	# response is not to find a cleverer symbol - there isn't one - but to
	# make the failure loud in two other places:
	#
	#   1. The FATAL_ERROR in the top-level CMakeLists.txt (and in
	#      strap/CMakeLists.txt), which compares what was ASKED for
	#      (-DRADIANT_BACKEND=cc26xx) against what Kconfig SELECTED. That
	#      is the guard that catches a rename on the first build, before
	#      any hardware is involved, and it is the one to trust.
	#   2. A BUILD_ASSERT in src/radiant_radio_cc26xx.c testing the same
	#      symbol, so a configuration that reached here by some other route
	#      still fails at compile time rather than on the air.
	#
	# The second alternative below is belt-and-braces of a different kind:
	# SOC_FAMILY_TI_SIMPLELINK is a SEPARATE symbol, set by the series
	# symbol above, and it is broader than we want (it also covers CC32xx).
	# Accepting it costs nothing, because the BUILD_ASSERT in the C file
	# names the part precisely - what it buys is that a rename of ONE of
	# the two symbols leaves the dependency met rather than silently unmet.
	# Two names for one fact is exactly the shape of the fix, and it is
	# what the nrf arm gets for free from Nordic having both.
	#
	depends on SOC_SERIES_CC13X2_CC26X2 || SOC_FAMILY_TI_SIMPLELINK
	select CLOCK_CONTROL
	help
	  src/radiant_radio_cc26xx.c: the RF core through TI's RF driver, in
	  proprietary (CMD_PROP_*) mode with a 1 Mbps 2-GFSK PHY built from a
	  BLE-derived override table. Receive and transmit.

	  Needs the hal_ti Zephyr module, which NCS's west manifest filters out
	  of its import - scripts/fetch_hal_ti.ps1 places it and the repo's own
	  west.yml carries the project for a workspace built from this
	  manifest. A build without it fails at the first <ti/drivers/rf/RF.h>.

	  NO TIMER AND NO CHOSEN NODE, unlike the nrf backend. The nRF's five
	  TIMER compares and five (D)PPI connections exist to build, in
	  hardware, the thing the RF core gives away: a radio operation with an
	  absolute start time. CMD_PROP_RX/CMD_PROP_TX with startTrigger =
	  TRIG_ABSTIME and startTime in RAT ticks IS radiant_rx_req::t_open and
	  radiant_tx_req::t_sync_at, so there is nothing to name in devicetree
	  and nothing to share.

	  The clock is the backend's own business and is the one place this is
	  harder than the nRF: the RAT is 32-bit at 4 MHz and wraps in ~17.9
	  minutes, so radiant_radio_now() folds it to 64 bits over a periodic
	  tick. A dongle left plugged in over a weekend must not acquire a
	  scheduling bug at minute 18.

endchoice

# â”€â”€ A setting of the nrf arm, and it has to live OUTSIDE the choice â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# It used to be inside it, between the nrf arm and `endchoice`, and that was a
# latent Kconfig dependency loop that only became fatal when a third arm was
# added. An `int` inside a choice is still a MEMBER of that choice, so the
# choice acquires a dependency on it, while it depends on the nrf arm, which
# depends on the choice:
#
#   RADIANT_CORE_BACKEND_NRF -> <choice> -> ..._NRF_IRQ_PRIO -> ..._BACKEND_NRF
#
# Kconfig reported exactly that cycle and refused the whole file - not the one
# line - so the symptom was a board that had never been built failing to
# configure with an error naming three symbols and no board. Two arms happened
# not to trip it; three did. The fix is where the symbol belongs anyway: it is
# a property OF a backend, not an alternative TO one.
config RADIANT_CORE_BACKEND_NRF_IRQ_PRIO
	int "RADIO interrupt priority"
	depends on RADIANT_CORE_BACKEND_NRF
	default 0
	help
	  radiant_radio_hal.h says callbacks run "at the highest priority the
	  backend uses", because re-arming from inside a completion callback is
	  the only path that meets a 1.55 ms acknowledged-data turnaround.
	  Lower this only with a measurement in hand.

# â”€â”€ Who owns the RADIO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# THIS USED TO BE A THIRD ARM OF THE CHOICE ABOVE, and moving it here is a
# decision rather than a tidy-up. "mpsl" was written as a separate BACKEND -
# a second implementation of the whole of radiant_radio_hal.h beside the nrf
# one. It is not: the nrf backend already knows how to turn a request into
# RADIO registers, a TIMER compare and two (D)PPI connections, and exactly one
# thing changes when a second protocol stack is on the chip - it stops being
# true that the radio is ours whenever we want it.
#
# So it is a seam inside the backend (src/radiant_radio_nrf_gate.h) rather than
# a backend beside it, and the reason is written down there: an A/B gate cannot
# detect the most likely failure of splitting that file, because
# radiant_radio_hal.h's own analysis says a t_sync calibration error moves RX
# yield at the same order as the bench's ~0.4 % collision floor.

config RADIANT_CORE_BACKEND_NRF_GATE_MPSL
	bool "arbitrate the RADIO with a second stack through MPSL timeslots"
	# NOT `depends on RADIANT_CORE_BACKEND_NRF`, which reads as the obvious
	# thing to write and is a Kconfig dependency loop: the nrf backend's own
	# `!BT` exclusion is relaxed by this symbol, so each would depend on the
	# other. The relationship is enforced where it can be - CMakeLists.txt
	# compiles a gate only under the nrf arm, so selecting this beside the
	# null backend selects nothing and builds the null backend as asked.
	# SELECT, NOT DEPENDS. It was `depends on MPSL`, and that is the same
	# silent-wrong-build trap scripts/build_all.ps1 documents for
	# -DRADIANT_BACKEND: nothing else in this tree turns MPSL on, so the only
	# reason it was ever set was that CONFIG_BT pulled it in. Ask for the
	# arbitrated build WITHOUT a second stack - which is exactly the A of
	# every coexistence A/B, and the only way to measure what the arbiter
	# costs on its own - and Kconfig dropped this symbol to n with a warning
	# in the middle of a hundred lines of them, compiled the direct backend,
	# and produced an image that works perfectly and answers a different
	# question than the one asked.
	select MPSL
	select MPSL_ASSERT_HANDLER
	help
	  Take the RADIO through MPSL's timeslot API instead of owning it, so
	  that a BLE controller or an 802.15.4 stack can share the chip. The
	  default is off and the Thread-free dongle build stays the safe
	  default; see ADR 0013 for what gives way to what.

	  THREE THINGS THIS TURNS FROM TUNING CHOICES INTO REQUIREMENTS:

	  CONFIG_MPSL_TIMESLOT_SESSION_COUNT must be at least 1. It defaults to
	  0, and with the default every session_open() fails while the image
	  still runs - so the failure is a dongle that refuses every arm rather
	  than a build error.

	  CONFIG_RADIANT_CORE_BACKEND_NRF_IRQ_PRIO must stay 0. mpsl.rst makes
	  the application responsible for the RADIO interrupt when the timeslot
	  API is used for RADIO access, and MPSL_HIGH_IRQ_PRIORITY is 0. The
	  default already satisfies it; what changes is that lowering it is no
	  longer a tuning choice with a measurement behind it, it is broken.

	  The tracked-slot reservation grows by the acknowledged-data reply it
	  may have to make (struct radiant_rx_req::follow_on_us), which takes
	  the tracked duty from ~3.2 % to ~9.3 % of the other stack's SCHEDULE.
	  It does not take its air, provided the reservation is released the
	  moment an empty window closes - which the backend does, and which is a
	  required line of the design rather than an optimisation.

config RADIANT_CORE_NRF_NO_RADIO0_IRQ
	bool "DIAGNOSTIC: leave the RADIO_0 NVIC line entirely to MPSL"
	depends on RADIANT_CORE_BACKEND_NRF_GATE_MPSL
	help
	  The last cut of the bisection through radiant_radio_init() and
	  radiant_radio_enable(), and the subtlest, because the line is shared by
	  agreement rather than by ownership.

	  RADIO_0 is MPSL's vector - mpsl_init.c connects it with
	  irq_connect_dynamic() and disables it first - but mpsl.rst also makes
	  the APPLICATION responsible for the RADIO interrupt when the timeslot
	  API is used for RADIO access. So both statements are true and the
	  question is who calls irq_enable(). This switch answers it by
	  experiment instead of by reading.

	  Never in a shipping image.

config RADIANT_CORE_NRF_NO_GPPI
	bool "DIAGNOSTIC: do not allocate the backend's (D)PPI connections"
	depends on RADIANT_CORE_BACKEND_NRF
	help
	  The third cut of the same bisection, and the one that asks whether the
	  backend's problem with another stack is a RESOURCE problem rather than
	  a register one. It takes five channels out of the same pool MPSL
	  allocates from (nrf/subsys/mpsl/hwres/mpsl_hwres.c calls straight
	  through to nrfx_gppi_channel_alloc), and it takes them at init, before
	  any other stack has started asking.

	  A build with this set CANNOT TRANSMIT OR RECEIVE AT ALL - the window
	  edges and the t_sync capture are all (D)PPI - so it is only ever useful
	  beside RADIANT_CORE_GATE_MPSL_NO_SESSION, where nothing was going to be
	  received anyway, to ask whether some other stack is healthy without it.

	  Never in a shipping image.

config RADIANT_CORE_NRF_NO_HFXO_HOLD
	bool "DIAGNOSTIC: do not take the backend's permanent HFXO request"
	depends on RADIANT_CORE_BACKEND_NRF
	help
	  The second half of the same bisection as
	  RADIANT_CORE_GATE_MPSL_NO_SESSION, and the two together split
	  radiant_radio_init() down the middle: this removes what it does to the
	  CLOCK, that removes what it does through MPSL.

	  A build with this set has WORSE ANT+ TIMING, not broken ANT+ timing,
	  and the difference is why it is a diagnostic rather than an option. The
	  spike in radiant_core/spike/mpsl_arb measured the 1 MHz timebase
	  running 0.42 % fast on the internal RC between grants without this
	  request - about a millisecond of slot-placement error per ANT+ period,
	  and it appears in no counter anywhere. So a run with this set is
	  answering a question about some OTHER stack's health, never about
	  ANT+'s.

	  Never in a shipping image.

config RADIANT_CORE_GATE_MPSL_NO_SESSION
	bool "DIAGNOSTIC: build the MPSL gate but never open a timeslot session"
	depends on RADIANT_CORE_BACKEND_NRF_GATE_MPSL
	help
	  A bisection aid. The image builds and boots exactly as the arbitrated
	  one does - the RADIO is configured, the HFXO request is taken, the
	  TIMER runs - but no timeslot session is opened, so no ANT+ operation
	  can ever be granted the air. The dongle answers every command and hears
	  nothing.

	  It exists to split one question in two. When something else on the chip
	  misbehaves beside this backend, the candidates are "what the backend
	  does to the RADIO at initialisation" and "what the timeslot session
	  does while it runs", and those need completely different fixes. With
	  this set, only the first is present.

	  It answered exactly that question once: with a BLE advertiser running,
	  the SoftDevice Controller asserts either way, which puts the fault in
	  initialisation rather than in arbitration. Keeping the switch is
	  cheaper than rediscovering that it was the useful cut.

	  Never in a shipping image. A dongle built this way is a dongle that
	  cannot receive.

# â”€â”€ The ISR stack, and it is a REQUIREMENT rather than a tuning knob â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# MPSL delivers SIGNAL_START on the INTERRUPT STACK, and that is where the
# arbitrated backend programmes the peripheral - it cannot be done earlier,
# because touching the compare or the (D)PPI outside a grant enables the RADIO
# inside another stack's event. apply_format() and apply_filters() write every
# register the operation needs, and apply_filters() carries two 8-byte arrays
# and a packing loop of its own.
#
# ZEPHYR'S DEFAULT 2048 IS NOT ENOUGH, and the way it fails is the reason this
# is a default here rather than a line in a document. The overflow happens
# inside the grant callback and resets the board; the default logging mode is
# deferred, so the fault message needs a thread that no longer exists, and the
# console simply stops mid-line. From the outside the dongle looks wedged
# rather than crashed - it boots, answers every serial command, opens a
# channel, and then goes quiet - and it is in fact rebooting several times a
# second. It took a build with CONFIG_LOG_MODE_IMMEDIATE=y to see the fault at
# all, after five wrong hypotheses about priorities and locks.
config ISR_STACK_SIZE
	default 4096 if RADIANT_CORE_BACKEND_NRF_GATE_MPSL

# â”€â”€ And the two THREAD stacks this gate runs the core from â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# The gate defers every call into the core to a work item, because arming
# reaches it from the RADIO interrupt inside a timeslot where the MPSL API is
# not callable. What that work item then does is deliver a terminal event -
# which runs the completion callback, which runs a whole scheduler pass, which
# may build and arm the next operation.
#
# THAT DOES NOT FIT IN 1024 BYTES, which is Zephyr's default system work queue
# stack, and the failure is the same silent reboot loop the ISR stack note
# above describes: overflow, reset, boot, overflow. Raising ISR_STACK_SIZE
# alone does not fix it and the fault dump looks identical, which is what makes
# this worth writing down - the two stacks fail the same way and only the
# thread name in the dump tells them apart.
config SYSTEM_WORKQUEUE_STACK_SIZE
	default 4096 if RADIANT_CORE_BACKEND_NRF_GATE_MPSL

# MPSL's own low-priority thread, which is where BLOCKED, CANCELLED and
# SESSION_IDLE are delivered from. Nothing of ours runs deep there - the
# handlers hand their work on rather than doing it - but the default is 1024
# and the margin over "hand it on" is not worth being tight about on a path
# that only runs when something has already gone wrong.
config MPSL_WORK_STACK_SIZE
	default 2048 if RADIANT_CORE_BACKEND_NRF_GATE_MPSL

config RADIANT_CORE_BACKEND_MPSL
	bool
	depends on RADIANT_CORE_BACKEND_NRF_GATE_MPSL
	help
	  Deliberately not user-selectable, and kept only so that an out-of-tree
	  configuration naming the old symbol fails to select a backend rather
	  than silently selecting the null one. The MPSL-arbitrated build is
	  CONFIG_RADIANT_CORE_BACKEND_NRF plus
	  CONFIG_RADIANT_CORE_BACKEND_NRF_GATE_MPSL.

config RADIANT_CORE_ANTR_API
	bool "compile the antr_* adapter (src/radiant_api.c)"
	default y
	help
	  src/radiant_api.c is the integration layer: it implements the fifty
	  antr_* entry points that src/ant_radio.h declares, on top of the
	  modules below it. It is the only file in the module that reaches out
	  to an application header, so it is the only one an application-free
	  build has to be able to leave out.

	  The unit-test application sets this to n. Its suites test the modules,
	  not the forwarding, and compiling the adapter there would drag
	  src/ant_radio.h's whole surface into a build that has no bridge to
	  satisfy it.

config RADIANT_CORE_CRC_REPAIR
	bool "repair single-bit CRC errors on tracked windows"
	default n
	help
	  src/radiant_crc_repair.c. On a tracked window that failed its CRC,
	  form the error syndrome from the received CRC and the computed one,
	  look it up in a table of every single-bit error, and flip the bit
	  back. At the sensitivity knee essentially every CRC failure is one
	  flipped bit - around 136 exposed bits at a 1e-4 bit error rate puts
	  two-bit failures two orders down - so this recovers nearly all of
	  them, for a table and no change on the air. Worth roughly 1-3 dB of
	  effective sensitivity.

	  THE ARITHMETIC THAT DECIDES WHETHER THIS IS SAFE. A frame with more
	  bit errors than one can have its syndrome land on a valid single-bit
	  entry by chance, and is then "repaired" into a frame that is still
	  wrong and now claims to be right.

	  TWO-BIT ERRORS CANNOT. The polynomial x^16 + x^12 + x^5 + 1 is
	  divisible by (x + 1), so a syndrome's popcount carries the parity of
	  the error's weight: odd-weight errors have odd-popcount syndromes and
	  even-weight errors have even-popcount ones, and the two sets are
	  disjoint. Since two-bit errors are by far the commonest multi-bit case
	  at the knee, that removes most of the exposure outright - and
	  test_crc_repair.c enumerates all 3160 of them to keep it true.

	  What is left is odd-weight errors of three bits and up, which collide
	  at roughly 1 in 341 and are themselves another order of magnitude
	  rarer than two-bit ones. That figure is 96 REACHABLE entries against
	  32768 odd-popcount syndromes: a standard tracked frame has 80 body
	  bits and 16 CRC bits, and the rest of the table names positions that
	  would lie inside the address, which are refused because a flipped
	  address bit never matches the filter in the first place. The same
	  suite measures the rate rather than asserting it.

	  On a tracked window that is acceptable: the hardware matched a full
	  5-byte address, so the frame is already known to be from the right
	  sensor, and one bad payload is something every ANT+ profile survives
	  because its values are cumulative. On a SEARCH window it would not be,
	  which is why the module refuses that configuration outright rather
	  than trusting the call site - a search window's CRC failures are the
	  19-27 noise-triggered address matches per 15 seconds that
	  radiant_search.c counts and discards, and one in 585 of those would
	  become a device number manufactured out of thermal noise.

	  Requires a backend whose caps.has_rx_crc is true; the repair path is
	  inert without one, because the received CRC is not in the body and a
	  syndrome cannot be formed without it.

	  Default n. Repaired frames are counted separately in
	  radiant_api_stats.crc_repaired, so an A/B can see how many there were
	  and never confuses one for a clean receive.

config RADIANT_CORE_PROFILE_SANITY
	bool "drop a repaired frame whose payload is not physically possible"
	depends on RADIANT_CORE_CRC_REPAIR
	default n
	help
	  src/radiant_profile_sanity.c. A third refutation for a repaired
	  frame, alongside the control-byte and transmission-type checks
	  radiant_crc_repair.h documents: for a bicycle power meter
	  (device type 0x0B), reject an instantaneous power reading above
	  3000 W; for a heart rate monitor (device type 0x78), reject a
	  computed heart rate above 240 bpm. Both figures are comfortably
	  above real human extremes - see radiant_profile_sanity.h for why
	  the originally proposed 1000 W / 200 bpm would have misclassified
	  genuine efforts - so a payload this module rejects is far more
	  likely a mis-repair than a real reading.

	  APPLIED TO REPAIRED FRAMES ONLY, exactly like the two checks in
	  radiant_crc_repair.h: the call site in src/radiant_api.c makes this
	  the caller's rule to keep, not this module's, because the same
	  range check against a CLEAN frame would silently delete the most
	  interesting moments of a ride - a track sprint, a hard effort -
	  and look like a receiver fault.

	  This is profile knowledge (what a payload byte MEANS), which is
	  deliberately not part of radiant_crc_repair.c or any other
	  frame-layer module - see radiant_profile_sanity.h for why it has
	  its own file and its own symbol instead.

	  Rejections are counted in radiant_api_stats.crc_repair_implausible,
	  separately from crc_repair_refuted, so an A/B can tell a structural
	  refutation (wrong control byte or transmission type) from a
	  physical-plausibility one.

config RADIANT_CORE_ED_SCAN
	bool "energy-detect scan and the channel-quality map"
	default n
	help
	  src/radiant_chanmap.c, the SLOT_ED slot kind in src/radiant_sched.c,
	  and radiant_radio_ed() in whichever backend is selected. Measures the
	  band on frequencies the link layer is not using, and aggregates the
	  result into a per-RF-index map on the same 1 dB scale as the
	  noise-floor histogram.

	  WHY IT EXISTS. The characterised ~0.4% loss floor on this bench is
	  memoryless per-slot collision at 2457 MHz, inside Wi-Fi channel 11.
	  Nothing in the dongle can fix that and moving off 2457 MHz can, but a
	  move is only as good as the evidence behind it - and today the only
	  evidence this stack collects is the noise floor of the one frequency
	  it is already on, which by construction can say nothing about a
	  candidate. This is the instrument that can.

	  NOTHING READS THE MAP. It is filled and logged, exactly like the noise
	  histogram, and no decision anywhere in the core consults it. That is
	  the condition on which building it now was worth it: adaptive
	  frequency selection is a separate piece of work with its own gate, and
	  it should arrive to find a measured map rather than build one and a
	  policy in the same change.

	  WHAT IT COSTS WHEN ON. Radio time, and only radio time nothing else
	  wanted: an ED chunk is the lowest-priority thing the scheduler can
	  arm, it never preempts, it merges with nothing, and it is bounded by
	  the gap ahead of the next committed operation. A dongle that is
	  searching measures nothing at all, deliberately. Plus 1000 bytes of
	  RAM for the map, which is 125 RF indices at eight bytes.

	  WHAT IT COSTS WHEN OFF. Nothing: the map compiles to no-op inlines,
	  the scheduler folds every ED branch away against a compile-time zero,
	  the backend compiles no sampling path, and caps.has_ed_scan is false
	  so the request entry point refuses before a slot is ever occupied.

	  Default n. Turn it on for bench work on frequency selection.

config RADIANT_SEC
	bool "per-channel payload security (X_AUTH, X_CONF)"
	default n
	help
	  src/radiant_sec.c and src/radiant_sec_aes.c: two orthogonal
	  per-channel payload transforms - X_AUTH (a spread AES-CMAC tag in
	  byte [7]) and X_CONF (AES-128-CTR over bytes [2..6]). Both are off
	  at runtime until a host configures them, and this symbol is off at
	  build time so that the overwhelming majority of builds carry none of
	  it. docs/radiant-security.md is normative.

	  A SECURED CHANNEL IS A RADIANT-ENVELOPE CHANNEL AND DOES NOT
	  INTEROPERATE WITH ANT+ POWER, HEART RATE OR SPEED-AND-CADENCE. The
	  transforms rewrite payload bytes that those profiles define, so a
	  Garmin head unit or Zwift reading a secured channel reads noise. Use
	  this on RadiANT device types, on a channel of its own.

	  Costs nothing when off, and that is a CI job rather than a claim:
	  the `zero-cost` workflow builds the same board at HEAD and at the
	  merge base and asserts the section sizes and the defined-symbol set
	  are identical, that no radiant_sec symbol exists, and that .config
	  says this symbol is not set.

if RADIANT_SEC

config RADIANT_SEC_CONF
	bool "compile X_CONF (confidentiality)"
	default y
	help
	  AES-128-CTR over bytes [2..6] of a data page in the secured range.
	  Bytes [0] and [1] stay in the clear so a receiver can tell a data
	  page from a descriptor and can build the nonce, which is what makes
	  the transform cost zero payload bytes.

	  Turn this off to build an authenticate-only node. That is not a
	  degraded configuration - "anyone can read my power, nobody can spoof
	  it" is the most useful setting in the table, and unlike encryption it
	  has no key distribution problem for readers.

config RADIANT_SEC_AUTH
	bool "compile X_AUTH (authenticity)"
	default y
	help
	  A spread AES-CMAC tag, one byte per packet in byte [7], covering a
	  window of W packets. The tag is 8*W bits: 16 at the default W=2, 32
	  at W=4, 64 at W=8.

	  An unverifiable window is DELIVERED, marked unverified, rather than
	  discarded - discarding costs W packets for every one lost, against a
	  measured ~0.4% bench loss floor, and hands an attacker a W-for-1
	  denial of service.

config RADIANT_SEC_MAX_CHANNELS
	int "secured channels"
	default 8
	range 1 32
	help
	  How many channels can hold security state at once. Roughly 120 bytes
	  each, allocated on the first SET_KEY and freed on unassign and on
	  reset - and zero when CONFIG_RADIANT_SEC is off, because the table
	  does not exist. Eight matches the legacy ANT+ channel ceiling.

config RADIANT_SEC_HOST_MESSAGES
	bool "compile the 0xF1-0xF5 host messages"
	default y
	depends on RADIANT_CORE_ANTR_API
	help
	  src/radiant_sec_host.c: the antr_sec_* adapter behind message IDs
	  0xF1 (configure), 0xF2 (set key), 0xF3 (epoch), 0xF4 (status) and
	  0xF5 (pairing). Mirrors the RADIANT_CORE_ANTR_API gate, because this
	  is the one security file that reaches an application header.

	  Without it the transforms exist and nothing can turn them on, which
	  is the right shape for a node application that configures its own
	  channels in C.

config RADIANT_SEC_PAIRING_X25519
	bool "X25519 pairing over the acknowledged/burst path"
	default n
	help
	  Vendored public-domain X25519 behind a single radiant_sec_x25519()
	  entry point, so a PKA backend can displace it without touching the
	  pairing logic. Its own symbol even when CONFIG_RADIANT_SEC is on,
	  because most deployments should use the out-of-band path - a QR code
	  or a typed key - which needs no protocol and has no attack surface
	  during pairing at all.

	  The 32-byte scalar comes from the host over 0xF5. There is no
	  entropy driver here and no PSA: on nRF54L the only entropy source is
	  psa_rng/CRACEN, and reaching it drags nrf_security into every build.
	  The honest consequence is that a host-less node cannot pair this way.

config RADIANT_SEC_HAS_RNG
	bool
	help
	  Hidden. Selected by whichever entropy backend is chosen below, and it
	  is what radiant_sec_caps().has_rng reports and what suppresses the
	  refusing radiant_sec_rng() in src/radiant_sec.c.

	  A separate symbol from the backend that selects it, so that policy -
	  and the node application above it - asks "is there entropy here" and
	  never "is CRACEN here". That is the same seam discipline the crypto
	  backends keep, and ADR 0009 pins it for this one specifically.

config RADIANT_SEC_RNG_PSA
	bool "PSA entropy backend (psa_generate_random, CRACEN on nRF54L)"
	default n
	select RADIANT_SEC_HAS_RNG
	help
	  src/radiant_sec_rng_psa.c: radiant_sec_rng() over psa_generate_random(),
	  for builds that already link nrf_security. Off by default, and the
	  default is the honest one for this project - reaching PSA drags
	  nrf_security into the build, which is the pinned reason
	  docs/radiant-security.md section 7.4 gives for the scalar coming from
	  the host in the first place.

	  ADR 0009 keeps this open rather than requiring it: a hostless node
	  derives its pairing scalar from K_dev and a counter, and where real
	  entropy exists it should be used instead. Turning this on changes
	  which of the three scalar sources wins and changes NOTHING about the
	  counter - pair_counter still advances before the public key is
	  transmitted, because its second job is forward secrecy and its first
	  is not being a fingerprint.

	  NOT BUILT BY ANY GATE IN THIS REPOSITORY. Nothing on the bench links
	  nrf_security, so this file's first compile will be on the part that
	  needs it. It is small and it is one PSA call, and that is the reason
	  the risk is acceptable rather than an argument that there is none.

config RADIANT_SEC_COMPAT
	bool "compat-mode attestation primitives (ANT+ device types)"
	default n
	help
	  src/radiant_sec_compat.c: the two attestation tags a RadiANT node
	  puts on an ANT+ device type. Tier I is an identity tag over the
	  nonce alone - trunc40( CMAC(K_auth, nonce_block) ) - and Tier II is
	  a window MAC over N consecutive transmitted messages, trunc48.
	  docs/radiant-security.md section 11.4 is normative and
	  docs/decisions/0008-antplus-additive-pages-and-compat-security.md
	  pins the bytes.

	  THIS IS THE OPPOSITE OF CONFIG_RADIANT_SEC'S CHANNELS, WHICH IS THE
	  point of it. A secured RadiANT channel rewrites payload bytes and
	  reads as noise to a head unit. A compat channel is a byte-exact ANT+
	  sensor to every legacy receiver and adds an authenticated page beside
	  its data, so a receiver holding K_auth can tell a stranger's
	  colliding sensor from yours cryptographically while Zwift keeps
	  reading it normally.

	  The tags, the emit hooks that put them on the air at their own
	  cadence, the receive path that judges them, and the epoch recovery a
	  receiver needs because the beacon deliberately carries no epoch
	  field. Still no init call and still no page numbers: the layer above
	  composes byte [0] from the subtype this one returns.

	  Off by default and dependent on RADIANT_SEC, and the zero-cost
	  discipline is inherited unchanged: no ops struct, no structs in
	  hot-path signatures, no-op static inlines when off, and the
	  `zero-cost` CI job asserting it rather than a comment claiming it.

config RADIANT_SEC_COMPAT_MAX_CHANNELS
	int "compat-attested channels"
	depends on RADIANT_SEC_COMPAT
	default 2
	range 1 8
	help
	  How many channels can hold compat attestation state at once.

	  672 bytes each, measured, and the bulk of that is two 248-byte window
	  buffers - the N-1 transmitted messages a Tier II tag covers, at the
	  largest legal N of 32, once for the transmit side and once for the
	  receive side. Two rather than eight because the shape of the feature
	  is one sensor per channel: a strap masters one compat channel, and a
	  receiver that tracks more than a couple of attested sensors at once
	  is the unusual case that should pay for itself here explicitly.

config RADIANT_SEC_BACKEND_MODES
	bool "the backend implements the mode level itself (test scaffold)"
	default n
	help
	  Suppresses the portable AES-CTR/AES-CMAC layer in
	  src/radiant_sec_aes.c so that something else can define the Level 2
	  entry points and radiant_sec_caps().

	  This exists so the seam is exercised rather than merely asserted.
	  radiant_core/tests/src/sec_modes_backend.c is an independent
	  mode-level implementation selected by this symbol, and the same
	  published vectors run against it - which is what proves the
	  mode-level path is live and that policy never reaches past it to the
	  block primitive.

	  A real hardware backend - CRACEN through PSA, CC310 - is what this
	  symbol is shaped for. None ships in v1.

endif # RADIANT_SEC

config RADIANT_CORE_SWEEP_DEBUG
	bool "log the search sweep's position once a second"
	default n
	help
	  Bench instrumentation for the discovery path. Once a second, from
	  api_housekeep(): the selected set, the steer queue depth, the dwell
	  credited so far, the sweep and scheduler counters, the pump and
	  housekeeping rates, armed length by slot kind, and how scan chunks
	  ended.

	  It exists because the sweep's RATE is invisible from the host. A sweep
	  running at half speed and a healthy one look identical over the wire -
	  same messages, same responses, no errors - until a device the dongle
	  could hear takes twenty seconds to appear. Two defects were found with
	  exactly these counters and neither showed up in any existing statistic:
	  a chunk-per-set round trip through the event thread, and a set
	  overspending its dwell because the chunk ceiling never came down.

	  Off by default. -DCONFIG_RADIANT_CORE_SWEEP_DEBUG=y on a debug build.

endif # RADIANT_CORE

