# prj.conf turns CONFIG_RADIANT_ANTR_API on, which is what compiles the adapter
# under test. Any scenario that enables CONFIG_RADIANT_SEC gets the host
# messages too, matching the applications.
config RADIANT_SEC_HOST_MESSAGES
	default y if RADIANT_ANTR_API && RADIANT_SEC

source "Kconfig.zephyr"
