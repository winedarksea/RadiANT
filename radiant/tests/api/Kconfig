# CONFIG_RADIANT_SEC_HOST_MESSAGES is the only symbol this application needs
# from src/Kconfig.antr_api - testcase.yaml's radiant.api.sec_host
# scenario turns it on to compile src/ant_sec_host.c in - but
# CONFIG_RADIANT_ANTR_API comes along with it from the same file. That is
# harmless: this application's own CMakeLists.txt adds
# ../../../src/ant_radio_radiant.c unconditionally rather than reading that
# symbol (see the comment there), so RADIANT_ANTR_API's value has no
# effect here either way - it is declared only because RADIANT_SEC_HOST_MESSAGES
# `depends on` it, and a `depends on` names a symbol that must exist.
rsource "../../../src/Kconfig.antr_api"

source "Kconfig.zephyr"
