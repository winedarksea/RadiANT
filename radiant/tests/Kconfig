# The radiant unit-test application's own Kconfig tree.
#
# It exists for two lines. src/node/Kconfig is sourced by the node and dongle
# applications rather than by radiant/Kconfig (ADR 0009 decision 7: node
# identity lives in the application), so without the rsource below this image
# could not set CONFIG_RADIANT_NODE_IDENT at all - and
# CONFIG_RADIANT_NODE_IDENT_SELF_PROVISION, which depends on it, would compile
# to nothing in the one image that tests it. The fake entropy backend is the
# other line.

rsource "../src/node/Kconfig"

config RADIANT_TEST_FAKE_RNG
	bool "test image: radiant_sec_rng() from tests/fake_rng.c"
	default n
	depends on RADIANT_SEC && !RADIANT_SEC_RNG_PSA && !RADIANT_SEC_RNG_ENTROPY
	select RADIANT_SEC_HAS_RNG
	help
	  Compiles tests/fake_rng.c, a deterministic radiant_sec_rng() with
	  injectable failures, and reports caps.has_rng - the same seam a real
	  entropy backend fills (ADR 0009), so that radiant_node_ident_boot()'s
	  first-boot provisioning (ADR 0020) runs here against the real
	  radiant_node_ident.c. Test images only: nothing outside radiant/tests sources
	  this file.

# The rules sink's per-output switches, repeated from radiant/Kconfig.
#
# There they sit under `if RADIANT_BRIDGE_RULES`, which this image leaves off:
# it compiles radiant_rules.c directly (CMakeLists.txt) instead of through the
# module. Without these lines the symbols would not exist here, so
# radiant_rules.c would see every output as disabled, and testcase.yaml's
# radiant.unit.rules_outputs_off scenario could not assign them at all.
# Same names, same default; the help text lives in radiant/Kconfig.

config RADIANT_BRIDGE_RULES_OUT_WORN
	bool "test image: derive Worn"
	default y

config RADIANT_BRIDGE_RULES_OUT_ACTIVE
	bool "test image: derive Active"
	default y

config RADIANT_BRIDGE_RULES_OUT_AT_REST
	bool "test image: derive At Rest"
	default y

config RADIANT_BRIDGE_RULES_OUT_ZONE2
	bool "test image: derive Zone 2"
	default y

config RADIANT_BRIDGE_RULES_OUT_ZONE3
	bool "test image: derive Zone 3"
	default y

config RADIANT_BRIDGE_RULES_OUT_IN_USE
	bool "test image: derive In Use"
	default y

source "Kconfig.zephyr"
