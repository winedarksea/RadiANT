/*
 * The dongle pulls in boards/common/usb/cdc_acm_serial.dtsi, which points
 * every console-ish chosen node at a CDC ACM instance on the same USB device
 * we need for the ANT vendor class. Detach them and disable the node, or the
 * USB stack comes up with two classes and neither behaves. Logging goes over
 * RTT (see prj.conf), so nothing is lost.
 *
 * uart0 is enabled in the board's dtsi and wired to pins we do not use.
 */
/ {
	chosen {
		/delete-property/ zephyr,console;
		/delete-property/ zephyr,shell-uart;
		/delete-property/ zephyr,uart-mcumgr;
		/delete-property/ zephyr,bt-mon-uart;
		/delete-property/ zephyr,bt-c2h-uart;
	};
};

&board_cdc_acm_uart {
	status = "disabled";
};

&uart0 {
	status = "disabled";
};
