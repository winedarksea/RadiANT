#
# ANT+ sensor simulator.
#
# One prefix for the whole application, ANT_SIM_*, the same way the dongle uses
# ANT_DONGLE_*. The two never build together, but a shared prefix would make a
# grep for "which application does this symbol belong to" ambiguous, and the
# answer to that question is how the sysbuild and CI assertions stay honest.
#

source "Kconfig.zephyr"

menuconfig ANT_SIM
	bool "ANT+ sensor simulator"
	select ANT
	select ANT_KEY_MANAGER
	select ANT_CHANNEL_CONFIG
	select ANT_STATE_INDICATOR
	select DK_LIBRARY
	default y
	help
	  Transmits as a realistic ANT+ sensor so a dongle can be tested
	  without owning one. Not a dongle build: this application has no USB
	  and no serial bridge.

if ANT_SIM

choice ANT_SIM_PROFILE
	prompt "Sensor profile to transmit"
	default ANT_SIM_PROFILE_BPWR_STANDARD

config ANT_SIM_PROFILE_BPWR_STANDARD
	bool "Bicycle power, standard power page 0x10"
	select ANT_BPWR
	help
	  The page every power meter emits. Instantaneous power, accumulated
	  power and cadence, one power event per message.

config ANT_SIM_PROFILE_BPWR_CRANK_TORQUE
	bool "Bicycle power, crank torque page 0x12"
	select ANT_BPWR
	help
	  Power carried as accumulated torque and accumulated crank period,
	  with one event per crank revolution rather than one per message. At
	  80 rpm that is roughly one message in three, which is the case a
	  receiver's delta arithmetic has to survive.

config ANT_SIM_PROFILE_BPWR_WHEEL_TORQUE
	bool "Bicycle power, wheel torque page 0x11"
	select ANT_BPWR
	help
	  The same arithmetic against wheel revolutions at road speed. Torque
	  is lower for the same power, so a receiver that confuses this page
	  with 0x12 is wrong by the gear ratio rather than obviously wrong.

config ANT_SIM_PROFILE_BSC_COMBINED
	bool "Combined speed and cadence, device type 0x79"
	select ANT_BSC
	help
	  Cadence event time and crank revolutions alongside speed event time
	  and wheel revolutions, in a page that carries no page number at all.

endchoice

menu "Signal"

config ANT_SIM_TARGET_WATTS
	int "Target power, watts"
	default 100
	range 0 2000
	help
	  Held, not swept. A receiver cannot be shown to be right about a value
	  that never settles, which is what the stock sdk-ant simulators
	  produce.

config ANT_SIM_TARGET_RPM
	int "Target cadence, rpm"
	default 80
	range 0 254
	help
	  254 is the maximum: 255 is the profile's "cadence not reported"
	  sentinel, and a target that reached it would turn cadence off rather
	  than report a very fast rider.

config ANT_SIM_WHEEL_RPM
	int "Wheel speed, rpm"
	default 238
	range 0 1000
	help
	  Used by the wheel torque page and by the speed half of the combined
	  page. 238 rpm is 30 km/h on a 2.105 m wheel.

config ANT_SIM_NOISE
	int "Noise band, plus or minus, on both signals"
	default 3
	help
	  Zero makes every delta identical, which hides an accumulator that is
	  recomputed from the target instead of accumulated.

config ANT_SIM_SEED
	int "Seed for the noise generator"
	default 1
	help
	  A run that cannot be replayed is not a measurement. Zero is accepted
	  and replaced internally, because xorshift is dead at zero.

endmenu

menu "Channel"

config ANT_SIM_CHANNEL_NUM
	int "ANT channel number"
	default 0

config ANT_SIM_NETWORK_NUM
	int "ANT+ network number"
	default 0

config ANT_SIM_DEVICE_NUMBER
	int "Channel ID: device number"
	default 14871
	range 1 65535
	help
	  Matches tools/ant_sim.py's default (0x3A17), so a capture from either
	  transmitter carries the same identity and the two are directly
	  comparable. Zero is excluded: on a channel ID it is the wildcard.

	  This is the TIER 0 number: provisioned once and stable thereafter.
	  Generate one with `tools/ant_identity.py provision` and set it here
	  rather than shipping the same number on every unit - a device number
	  that is a factory serial ties the node to a purchase record, a
	  warranty and a previous owner, and that is what the identity tiers in
	  docs/radiant-security.md section 4 exist to correct.

config ANT_SIM_IDENTITY_TIER_2
	bool "Tier 2: re-roll the device number at every power-up"
	default n
	select ENTROPY_GENERATOR
	help
	  Take a fresh random device number on every boot, instead of using
	  ANT_SIM_DEVICE_NUMBER. This is identity Tier 2 in
	  docs/radiant-security.md section 4.

	  IT SILENTLY LOSES STANDARD RECEIVERS. A Garmin head unit or Zwift
	  pairs by device number, so every session looks like a new sensor and
	  the user has to re-pair. That is the cost, it is why the tier is
	  off by default, and it is why the tier is RadiANT-device-types-only
	  in the specification.

	  A keyed RadiANT receiver does NOT re-pair: it wildcard-searches its
	  device type and confirms identity by whether X_AUTH verifies under
	  its key. Resolution happens once at acquisition rather than every 128
	  seconds, which is the entire reason this is affordable and continuous
	  rotation was not.

	  Tier 1 - re-roll on explicit user action - has no expression here:
	  this application has no non-volatile storage, so "re-roll and keep
	  the new number" cannot be honoured across a reset. Provision a new
	  number with `tools/ant_identity.py reroll` and rebuild, which is the
	  same thing at a simulator's granularity.

	  Selects ENTROPY_GENERATOR rather than falling back to a weak source:
	  a device number an attacker can enumerate is not a re-roll.

config ANT_SIM_PRIVACY_PAGES
	bool "Emit the privacy common pages"
	default n
	help
	  Page 81 carries the not-supplied serial sentinel (0xFFFFFFFF) instead
	  of ANT_SIM_SERIAL_NUM.

	  This matters more than the device number does. A 32-bit globally
	  unique serial broadcast in the clear every 30 seconds is STRICTLY
	  MORE IDENTIFYING than a 16-bit device number, and it is unaffected by
	  any re-roll - so a Tier 2 node that keeps broadcasting its serial has
	  not changed identity, it has added a field. See
	  docs/radiant-security.md section 5.4, where the rule is normative and
	  independent of every security switch.

	  Page 82 is not emitted by this application at all, which is the other
	  half of the rule already satisfied, and ANT_SIM_MFG_ID already
	  defaults to the generic development id rather than to somebody
	  else's.

config ANT_SIM_TRANS_TYPE
	int "Channel ID: transmission type"
	default 5
	range 1 255
	help
	  5 throughout this project - tools/ant_sim.py, this application, and
	  the master path in zephyr_aerosense. The profile permits others; what
	  matters is that everything here picks the same one.

config ANT_SIM_RF_FREQ
	int "RF frequency, MHz above 2400"
	default 57
	range 0 124
	help
	  57 is 2457 MHz, the ANT+ public network frequency, and is the only
	  value at which this simulator is a valid ANT+ sensor. Leave it there
	  for any test of what a dongle will do in the field.

	  Change it only to answer one question: whether packet loss on the
	  bench is the radio environment or the boards. 2457 MHz is inside
	  Wi-Fi channel 11 and shared with every other ANT+ device in range,
	  so a run there measures the room as much as the dongle. Repeating a
	  run somewhere quiet - 2 or 78, either end of the band and clear of
	  Wi-Fi 1, 6 and 11 - separates the two. Loss that vanishes was the
	  room; loss that follows is worth chasing.

	  tools/ant_verify.py --rf-freq has to be given the same number, or
	  the two are not on the same channel and nothing is heard at all.

config ANT_SIM_TX_POWER
	int "Transmit power level"
	default 3
	range 0 5
	help
	  sdk-ant's levels: 0 is -20 dBm, 1 is -12, 2 is -4, 3 is 0 dBm and
	  the ANT default, 4 is +4 dBm. Level 5 (+8 dBm) exists only on the
	  nRF52820, nRF52833 and nRF52840 and is refused elsewhere.

	  THAT RESULT IS REGIME-DEPENDENT AND THE PARAGRAPH BELOW OVERSTATES
	  IT. Read this first.

	  Changing this does not measurably change packet loss WHEN THE LINK
	  ALREADY HAS MARGIN. Across 300 s runs at -12, 0 and +4 dBm - a 16 dB
	  spread - loss stayed between 0.85 and 1.37 %, which is the
	  run-to-run spread of the 0 dBm setting on its own. Loss that
	  survives 16 dB is not a link-budget problem: it is other traffic
	  landing on top of a 150 us slot, and a slot that is occupied is
	  occupied at any power.

	  BUT THAT WAS MEASURED AT ~1 % LOSS, and it does not generalise to a
	  marginal link. Re-measured 2026-08-15 on an nRF54L15 DK master
	  against an unchanged Feather receiver, in a room where the same rig
	  was losing 5-8 %:

	      level 3 (0 dBm)   4.87 / 7.04 / 7.23 / 7.94 %   -53..-55 dBm
	      level 4 (+4 dBm)  3.07 / 2.22 %                 -49 dBm

	  One rebuild, nothing else changed. Power more than halved the loss,
	  and it halved the RUN-TO-RUN SPREAD too, from 3.07 pp to 0.85 pp -
	  which is what tools/ab_gates.toml's repeat_a_max_delta_pp actually
	  gates on. So when loss is already near the floor, power is
	  irrelevant and the paragraph above holds; when the link is short of
	  margin, power is the first thing to check and the paragraph above
	  will send you looking in the wrong place.

	  Note level 5 (+8 dBm) is nRF52-only, so an nRF54L master CANNOT
	  reach the power a Feather master can. That is a concrete reason to
	  prefer the Feather as the transmitter for any loss baseline, and it
	  is what docs/radiant-bridge.md section 7.4.3 asks for in as many
	  words.

	  Those figures were taken before a host-side USB read timeout was
	  found to be inventing about 0.4 points of loss on every run, so they
	  are all too high by roughly the same amount - see the README. The
	  error is common to all three, so the comparison they were made for
	  survives it. The real floor on that bench is nearer 0.4 %.

	  There is now a number behind the reasoning rather than an argument.
	  ant_verify.py asks for RSSI and reports it: the two boards on a desk
	  sit near -28 dBm against a tracking threshold around -90, so there
	  is some 60 dB of margin and this knob spans 16. Loss measured within
	  one run went the wrong way against signal strength as the room
	  changed - more of it in the strongest stretch, none in the weakest -
	  which is not what running out of signal looks like.

	  So this is here to rule that out, not to tune it. A real power meter
	  runs at 0 dBm and a dongle has to work with one, which is what level
	  3 leaves you testing.

endmenu

menu "Product information"

config ANT_SIM_HW_VERSION
	int "Hardware revision"
	default 1
	range 0 255

config ANT_SIM_MFG_ID
	int "Manufacturer ID"
	default 255
	range 0 65535
	help
	  255 is the development manufacturer id. Borrowing a real one would
	  make this sensor claim to be somebody's product.

config ANT_SIM_MODEL_NUM
	int "Model number"
	default 1
	range 0 65535

config ANT_SIM_SW_VERSION
	int "Software version"
	default 1
	range 0 255

config ANT_SIM_SERIAL_NUM
	int "Serial number"
	default 5526867
	range 0 2147483647

config ANT_SIM_CALIBRATION_DATA
	int "Calibration data returned to a display that asks"
	default 21930
	range 0 65535

endmenu

endif # ANT_SIM
