# RadiANT smart trainer. See src/main.c and docs/smart-trainer-reference-design.md.

rsource "../../radiant/src/node/Kconfig"
rsource "../../radiant/src/profiles/Kconfig"
rsource "../common/Kconfig.ant_api"

# Redeclared defaults go BEFORE Kconfig.zephyr, or they are silently dead.
config MPSL_TIMESLOT_SESSION_COUNT
	default 2 if SMART_TRAINER_BLE && RADIANT_GATE_MPSL_D2
	default 1 if SMART_TRAINER_BLE

config BT_PERIPHERAL_PREF_MIN_INT
	default SMART_TRAINER_BLE_MIN_CONN_INTERVAL_UNITS if SMART_TRAINER_BLE

config BT_PERIPHERAL_PREF_MAX_INT
	default SMART_TRAINER_BLE_MIN_CONN_INTERVAL_UNITS if SMART_TRAINER_BLE

config BT_PERIPHERAL_PREF_LATENCY
	default 0 if SMART_TRAINER_BLE

config BT_PERIPHERAL_PREF_TIMEOUT
	default 400 if SMART_TRAINER_BLE

config RADIANT_BLE_CONN_MIN_INTERVAL_UNITS
	default SMART_TRAINER_BLE_MIN_CONN_INTERVAL_UNITS if SMART_TRAINER_BLE

source "Kconfig.zephyr"

menuconfig SMART_TRAINER
	bool "RadiANT smart trainer"
	default y
	select RADIANT_PRODUCT
	select RADIANT_PRODUCT_APP_UNIT_BOOT
	help
	  A controllable bike trainer: ANT+ FE-C (0x11, equipment type 25)
	  with FTMS Indoor Bike over BLE beside it on one radio, one
	  equipment state behind both, and the shared FE-C/FTMS control
	  arbiter between them. See docs/smart-trainer-reference-design.md.

if SMART_TRAINER

config SMART_TRAINER_DEVICE_NUMBER
	int "ANT device number used only when identity boot fails"
	range 1 65535
	default 4245
	help
	  Used only when radiant_node_ident_boot() fails, and then logged as an
	  error: every trainer built from one image would share it. A strict
	  build (dual.conf) never uses it - it stays off the air and retries.
	  4245 so the reference designs on one bench are distinct devices
	  (hrm_ble 4242, treadmill 4243, the trainer simulator 4244).

choice SMART_TRAINER_SOURCE
	prompt "trainer source"
	default SMART_TRAINER_SOURCE_SIMULATED
	help
	  Which implementation of src/trainer_source.h's seam is compiled in.

config SMART_TRAINER_SOURCE_SIMULATED
	bool "simulated - a synthetic rider on apps/trainer's physics model"
	help
	  src/trainer_sim.c: a 200 W / 90 rpm rider on the FE-C SS8.8.4 model
	  of apps/trainer/src/trainer_model.c (compiled from there, not
	  copied). It honours every control mode, so both radios' command
	  paths reach a brake that answers.

config SMART_TRAINER_SOURCE_CUSTOM
	bool "custom - your driver, registered at boot"
	help
	  Nothing in this tree implements the seam under this option. Your
	  driver calls trainer_source_register() from a SYS_INIT. Without
	  one, the trainer transmits with every measurement invalid and no
	  control mode declared - never a simulated rider on a real machine.

endchoice

config SMART_TRAINER_SIM_BUTTONS
	bool "simulator: the DK's four buttons are the console"
	depends on SMART_TRAINER_SOURCE_SIMULATED
	depends on GPIO
	depends on $(dt_alias_enabled,sw0) && $(dt_alias_enabled,sw1)
	depends on $(dt_alias_enabled,sw2) && $(dt_alias_enabled,sw3)
	default y
	help
	  sw0 opens the BLE pairing window (hold 5 s to forget every bond),
	  sw1 stops/resumes the simulated rider, sw2 is a console stop and
	  sw3 a console reset (both bump the session epoch).

# ── Advertised capabilities ──────────────────────────────────────────────────
#
# Each can only TAKE AWAY a capability the source has: a mode is declared (FE-C
# page 54, FTMS Target Setting) exactly when its hook exists AND this is on,
# and a declared mode is always honoured.

config SMART_TRAINER_CAP_ERG
	bool "advertise target power (ERG) if the source can"
	default y
	help
	  FE-C page 54 Target Power mode with page 49, FTMS Power Target
	  Setting with op code 0x05. FE-C SS10.1.3.1: a controllable FE shall
	  support at least target power mode, so turn this off only with
	  care.

config SMART_TRAINER_CAP_RESISTANCE
	bool "advertise basic resistance if the source can"
	default y
	help
	  FE-C page 54 Basic Resistance mode with page 48, FTMS Resistance
	  Target Setting with op code 0x04.

config SMART_TRAINER_CAP_SIM
	bool "advertise simulation if the source can"
	default y
	help
	  FE-C page 54 Simulation mode with pages 50/51 (and 55 applied),
	  FTMS Indoor Bike Simulation Parameters with op code 0x11.

config SMART_TRAINER_MIN_POWER_W
	int "minimum target power, W"
	range 0 1000
	default 0
	help
	  The FTMS Supported Power Range minimum, and the floor an FE-C page
	  49 is clamped to. A source that states its own range overrides.

config SMART_TRAINER_MAX_POWER_W
	int "maximum target power, W"
	range 100 4000
	default 2000
	help
	  The FTMS Supported Power Range maximum, and the ceiling an FE-C
	  page 49 is clamped to. A source that states its own range overrides.

# ── BLE ──────────────────────────────────────────────────────────────────────

config SMART_TRAINER_BLE
	bool "also advertise FTMS (Indoor Bike) over BLE"
	depends on BT && BT_PERIPHERAL
	select BT_SMP
	select RADIANT_BLE
	select RADIANT_BLE_FTMS
	select RADIANT_BLE_FTMS_INDOOR_BIKE
	select RADIANT_BACKEND_NRF_GATE_MPSL
	select BT_LL_SOFTDEVICE
	select RADIANT_CTRL_ARBITER
	help
	  FTMS 0x1826 as an Indoor Bike, through the shared core
	  radiant_ble_ftms, beside the ANT+ FE-C master on one radio.
	  BT_SMP is required: the Control Point needs encryption (FTMS
	  Table 4.1).

	  THE ARBITER IS NOT A SUPPRESSION RULE. FE-C pages and FTMS
	  notifications always go to every listener; the token decides only
	  whose setpoint the brake obeys (radiant_ctrl_arbiter.h).

config SMART_TRAINER_BLE_ADV_INTERVAL_MS
	int "BLE advertising interval, milliseconds"
	depends on SMART_TRAINER_BLE
	range 100 10000
	default 1000
	help
	  Policy, not power tuning: MPSL ranks the Bluetooth controller above
	  radiant, so a shorter interval takes air from the ANT+ master.

config SMART_TRAINER_BLE_MIN_CONN_INTERVAL_UNITS
	int "shortest connection interval to accept, 1.25 ms units"
	depends on SMART_TRAINER_BLE
	range 6 3200
	default 800
	help
	  800 units is 1 s, the same policy as apps/treadmill and
	  apps/hrm_ble; enforced by radiant_ble_conn.c.

config SMART_TRAINER_BLE_NOTIFY_INTERVAL_MS
	int "Indoor Bike Data notification interval, milliseconds"
	depends on SMART_TRAINER_BLE
	range 200 5000
	default 1000
	help
	  FTMS: "at a regular interval, typically once per second", not
	  client-configurable.

config SMART_TRAINER_PAIRING_WINDOW_S
	int "pairing window opened at the trainer, seconds"
	depends on SMART_TRAINER_BLE && RADIANT_BLE_PAIRING_WINDOW
	range 10 600
	default 120
	help
	  How long radiant_ble_pairing_window_open() runs when the source
	  reports TRAINER_EVT_PAIRING_WINDOW (the simulator: sw0).

config SMART_TRAINER_CTRL_ANT_TIMEOUT_MS
	int "release an idle ANT+ control claim after, milliseconds"
	depends on SMART_TRAINER_BLE
	range 1000 600000
	default 30000
	help
	  ANT+ is connectionless, so this is the only release an FE-C
	  controller's implicit claim has.

module = SMART_TRAINER
module-str = smart_trainer
source "subsys/logging/Kconfig.template.log_config"

endif # SMART_TRAINER
