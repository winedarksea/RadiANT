# SPDX-License-Identifier: Apache-2.0
#
# Your product's identity. Copy to product.conf, fill in every line, and
# build with dual.conf (see dual.conf's header). One record feeds both radios:
# ANT+ common pages 80/81 and the Bluetooth
# Device Information Service. CONFIG_RADIANT_PRODUCT_STRICT, which dual.conf
# turns on, refuses to configure while any of the first, second or fourth
# lines is still a placeholder.
#
# The device number and the 32-bit serial are NOT here: each unit derives its
# own from the identity key it generates on first boot (ADR 0020), so every
# unit built from one image is distinct with no factory step.

# Assigned by the ANT+ Alliance. 255 is the development id and is refused.
CONFIG_RADIANT_PRODUCT_MANUFACTURER_ID=255
# DIS Manufacturer Name String, at most CONFIG_BT_DIS_STR_MAX (21) characters.
CONFIG_RADIANT_PRODUCT_MANUFACTURER_NAME="Your Company"
# ANT+ page 80's numeric model number.
CONFIG_RADIANT_PRODUCT_MODEL_NUMBER=1
# DIS Model Number String, at most 21 characters.
CONFIG_RADIANT_PRODUCT_MODEL_NAME="Your Treadmill"
# Page 80's hardware revision and the DIS Hardware Revision String.
CONFIG_RADIANT_PRODUCT_HW_REV=1
# The software revision follows the repository VERSION file by default
# (main = MAJOR*10+MINOR, supplemental = PATCHLEVEL). To state it by hand:
#CONFIG_RADIANT_PRODUCT_SW_REV_FROM_VERSION=n
#CONFIG_RADIANT_PRODUCT_SW_REV_MAIN=10
#CONFIG_RADIANT_PRODUCT_SW_REV_SUPP=255

# The advertised BLE name. At most 29 characters here (23 with the suffix): it is in the scan response.
CONFIG_BT_DEVICE_NAME="Your Treadmill"
# Optional: advertise "<name> <device number>" so units can be told apart.
#CONFIG_RADIANT_BLE_NAME_DEVNUM_SUFFIX=y
