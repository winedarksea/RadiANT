#
# RadiANT treadmill - the fitness-equipment reference design.
#
# One prefix for the whole application, TREADMILL_*, the same way the dongle
# uses ANT_DONGLE_*, the heart-rate node uses HRM_* and the simulator uses
# ANT_SIM_*. They never build together, but a shared prefix would make "which
# application does this symbol belong to" ambiguous, and the answer to that
# question is how the CI assertions stay honest.
#

rsource "../../radiant/src/node/Kconfig"
rsource "../../radiant/src/profiles/Kconfig"
rsource "../common/Kconfig.ant_api"

# ── Defaults this application imposes on symbols it does not own ────────────
#
# BEFORE `source "Kconfig.zephyr"`, and that placement is the whole mechanism.
# Kconfig collects every `default` of a symbol in the order the definitions are
# parsed and takes the FIRST whose condition holds. nrfxlib's own definition of
# MPSL_TIMESLOT_SESSION_COUNT carries `default 0`; if this block were parsed
# after it, ours would be dead and the .config would read 0 with no error
# anywhere.
#
# WHY THE SYMBOL MATTERS. Every timeslot session_open() fails when the count is
# 0, while the image still runs - so the arbitrated build's failure mode is a
# node that refuses every arm rather than a build error, and on a bench that is
# indistinguishable from a dead antenna. radiant/Kconfig's help for
# RADIANT_BACKEND_NRF_GATE_MPSL says so at length. apps/hrm_ble learned this
# the expensive way; this application inherits the answer rather than the
# lesson.
#
# THE NUMBER IS THE GATE'S SESSIONS: one, plus one for RADIANT_GATE_MPSL_D2's
# second session (default y on MPSL gate builds). The flash-sync driver's
# session is NOT counted here: NCS adds it to MPSL's pool itself
# (SOC_FLASH_NRF_RADIO_SYNC_MPSL_TIMESLOT_SESSION_COUNT, mpsl_init.c). The pool
# is shared, though, so a count that misses D2 lets the gate's second session
# take flash sync's slot and every settings write fails with -12 - see
# apps/hrm_ble/Kconfig, where that happened on hardware.
config MPSL_TIMESLOT_SESSION_COUNT
	default 2 if TREADMILL_BLE && RADIANT_GATE_MPSL_D2
	default 1 if TREADMILL_BLE

# BT_PERIPHERAL_PREF_* redeclaration, carried over from apps/hrm_ble/Kconfig -
# see that file's block on these same four symbols for the full reasoning
# (Zephyr's own 24/40/0/42 defaults, the placement-before-Kconfig.zephyr
# mechanism, and the timeout*4 > (1+latency)*interval_max derivation). Keyed
# on this application's own symbols rather than hrm_ble's, and TIMEOUT is the
# same 400 for the same bound: interval_max=800, latency=0 still requires
# timeout>200, and 400 is 2x that floor.
#
# ONE DIFFERENCE FROM hrm_ble: there is no TREADMILL_SUPPRESS_ANT_WHEN_CONNECTED
# to protect - "THERE IS NO SUPPRESSION RULE HERE" above, the contended case is
# normal - so the 400 timeout is doing less work here than on the strap. It is
# kept anyway, for the same reason the strap does not go larger: a shorter
# timeout would let a normal signal hiccup flip connection state, and a longer
# one buys nothing when there is no suppression state to protect from a stale
# "connected" read.
config BT_PERIPHERAL_PREF_MIN_INT
	default TREADMILL_BLE_MIN_CONN_INTERVAL_UNITS if TREADMILL_BLE

config BT_PERIPHERAL_PREF_MAX_INT
	default TREADMILL_BLE_MIN_CONN_INTERVAL_UNITS if TREADMILL_BLE

config BT_PERIPHERAL_PREF_LATENCY
	default 0 if TREADMILL_BLE

config BT_PERIPHERAL_PREF_TIMEOUT
	default 400 if TREADMILL_BLE

# The shared layer's connection-parameter policy (radiant/src/ble/
# radiant_ble_conn.c) enforces this application's interval. Same placement
# rule as above: before Kconfig.zephyr.
config RADIANT_BLE_CONN_MIN_INTERVAL_UNITS
	default TREADMILL_BLE_MIN_CONN_INTERVAL_UNITS if TREADMILL_BLE

source "Kconfig.zephyr"

menuconfig TREADMILL
	bool "RadiANT treadmill node"
	default y
	# Pages 80/81 come from the product record; the manufacturer id that
	# used to be TREADMILL_MANUFACTURER_ID is
	# CONFIG_RADIANT_PRODUCT_MANUFACTURER_ID.
	select RADIANT_PRODUCT
	select RADIANT_PRODUCT_APP_UNIT_BOOT
	help
	  A RadiANT NODE that is fitness equipment: radiant driving TWO ANT+
	  master channels - FE-C (0x11) and Stride Based Speed and Distance
	  (0x7C) - with FTMS and RSC over BLE beside them on one radio.

	  It is the second reference design in this tree, after
	  apps/hrm_ble, and it exists to answer a question that one could not:
	  what a node looks like when it is TOLD things as well as measuring
	  them. A chest strap has no control surface; a treadmill has two
	  (FE-C page 51 and the FTMS control point) and they have to agree.

	  See docs/treadmill-reference-design.md.

if TREADMILL

config TREADMILL_DEVICE_NUMBER
	int "ANT device number used only when identity boot fails"
	range 1 65535
	default 4243
	help
	  Used only when radiant_node_ident_boot() fails - no entropy backend to make
	  K_dev from, a storage error, an exhausted boot counter - and the boot
	  log then says so at error level. Normally the node generates K_dev on
	  its first boot (ADR 0020) and takes its device number from the
	  identity record, which is what ADR 0009 requires.

	  A SHIPPED PRODUCT MUST NOT RUN ON THE FALLBACK: every treadmill built
	  from one image shares it. For a single demo that is fine. FOR A GYM IT
	  IS FATAL - twenty machines answering to one device number is twenty
	  machines a receiver cannot tell apart - which is why the boot log
	  reports the fallback as an error.

	  4243 rather than apps/hrm_ble's 4242, so the two reference designs on
	  one bench are two devices.

	  Avoid numbers with a long alternating bit run in the on-air address:
	  nRF-based receivers lose up to ~5 % of their frames (ADR 0019). The
	  number goes out as both FE-C and SDM, so check it with
	  `tools/ant_identity.py check <number> --device-type 0x11
	  --device-type 0x7C`. The image logs a warning when it opens a channel
	  with such a number.

# ── The ANT+ side ───────────────────────────────────────────────────────────

config TREADMILL_ANT_SDM
	bool "also transmit ANT+ Stride Based Speed and Distance (0x7C)"
	default y
	help
	  A SECOND master channel beside FE-C. FE-C is what a control-capable
	  head unit pairs with; SDM is what anything that only knows foot pods
	  pairs with, which includes Zwift Run and most watches. Emitting both
	  costs two transmit slots per ~250 ms and buys the whole
	  compatibility surface.

	  TURNING IT OFF IS A COEXISTENCE FALLBACK AND IT EXISTS BEFORE IT IS
	  NEEDED, on purpose. Two ANT+ masters plus BLE on one radio is more
	  contention than anything this project has measured: the arbiter has
	  been characterised with one master beside BLE (P8b) and with eight
	  masters beside 802.15.4 (P3.5), but not this mix. The two periods -
	  8192 and 8134 counts - beat against each other with a period of
	  about 32 seconds, so if they interact badly the symptom is a slow
	  cycle of loss on both channels rather than a steady figure. This
	  symbol is what a bench operator turns off to find out.

config TREADMILL_FEC_METABOLIC
	bool "emit FE-C page 18 (METs, calories)"
	help
	  Optional in the profile and off by default here. The number behind
	  it is an ACSM population-average estimate computed in
	  src/treadmill_state.c from belt speed, grade and a user mass that a
	  controller may never have sent - see that file for the equation and
	  its assumptions. Nothing anywhere depends on it, which is the only
	  reason a population average is acceptable at all.

	  METs are deliberately NOT reported even when this is on: a METs
	  field reads as a physiological statement about the person on the
	  belt in a way a calorie counter on a console does not.

# ── The source seam ─────────────────────────────────────────────────────────
#
# A CHOICE AND NOT A BOOL, AND THAT IS THE SAFETY PROPERTY. With a bool
# ("enable the simulator") a manufacturer who forgets to turn it off ships a
# treadmill that reports a synthetic runner while somebody stands on it, and
# nothing in the build says so. A choice makes "I forgot to unhook the
# simulator" impossible to express: exactly one arm is compiled, exactly one
# treadmill_source_register() call is linked, and the boot log names which.
#
# There is deliberately NO fallback from TREADMILL_SOURCE_CUSTOM to the
# simulator. See that symbol's help.
choice TREADMILL_SOURCE
	prompt "treadmill source"
	default TREADMILL_SOURCE_SIMULATED
	help
	  Which implementation of src/treadmill_source.h's seam is compiled in.
	  The seam is push (source-driven) for measurements and pull
	  (application-driven) for commands, and both directions are described
	  in that header. Read it before writing one.

config TREADMILL_SOURCE_SIMULATED
	bool "simulated - a synthetic runner, no hardware"
	help
	  src/treadmill_sim.c. A DK has no belt and no deck. It runs a 150 s
	  workout on repeat so that every accumulator on every page actually
	  moves on a bench - a node reporting a fixed speed makes a stuck
	  encoder and a working one look the same - and it honours both
	  control paths with a ramp, so the reporting loop is exercised rather
	  than short-circuited.

config TREADMILL_SOURCE_CUSTOM
	bool "custom - your driver, registered at boot"
	help
	  NOTHING IN THIS TREE IMPLEMENTS THE SEAM UNDER THIS OPTION. Your
	  code calls treadmill_source_register() before main()'s
	  treadmill_source_start(), from a SYS_INIT() or from a driver's own
	  init hook. src/treadmill_source_custom.c is compiled instead and
	  contains the porting instructions and a boot-time warning.

	  If your driver does not register, the node reports a stopped belt at
	  zero grade in the READY state, forever, and logs an error at boot.
	  That is the CORRECT failure and it is deliberately NOT a fallback to
	  the simulator: a machine quietly reporting a synthetic runner while
	  somebody stands on it is invisible from the receiving end, and one
	  reporting a stopped belt is not - and on a gym dashboard it reads as
	  "unoccupied", which is the safe direction to be wrong in.

endchoice

config TREADMILL_SIM_REMOTE_ENABLED
	bool "simulator: remote control enabled at boot"
	depends on TREADMILL_SOURCE_SIMULATED
	default y
	help
	  The simulated console's remote-enable switch at power-on, which is
	  half of the source's remote_motion_allowed() (the other half is the
	  safety key). With it off, every remote motion command - FTMS
	  Start, speed, incline, FE-C page 51 - is refused until the switch
	  is toggled (TREADMILL_SIM_BUTTONS: sw1). Stopping always works.

config TREADMILL_SIM_BUTTONS
	bool "simulator: the DK's four buttons are the console"
	depends on TREADMILL_SOURCE_SIMULATED
	depends on GPIO
	depends on $(dt_alias_enabled,sw0) && $(dt_alias_enabled,sw1)
	depends on $(dt_alias_enabled,sw2) && $(dt_alias_enabled,sw3)
	default y if !RADIANT_NRF_LOW_POWER
	help
	  sw0 pulls/replaces the safety key, sw1 toggles remote control,
	  sw2 is the console's Start/Pause (hold 1.5 s for Stop), sw3 opens
	  the BLE pairing window (hold 5 s to forget every bond). See
	  src/treadmill_sim.c.

# ── Remote motion ───────────────────────────────────────────────────────────
#
# THE MOTION RULE (src/treadmill_session.h). Every path that can start the
# belt, raise its speed or move the deck goes through treadmill_motion_permitted()
# and nothing else: FTMS Start/Resume, Set Target Speed, Set Target Inclination,
# the incline half of FTMS Reset, FE-C page 51 and the BLE grade provider.
# Stopping always passes.

config TREADMILL_REMOTE_START
	bool "allow a remote controller to START the belt"
	help
	  Off by default, and the default is the safety decision. With it off
	  a remote controller - an FTMS client or an FE-C head unit - can
	  change speed and grade only while the belt is ALREADY RUNNING
	  (started at the console), and can always stop it. FTMS Start/Resume
	  and a Set Target Speed above 0 from Idle, Paused or Stopped answer
	  0x05 Control Not Permitted.

	  Turn it on only for a machine whose own design makes a remotely
	  started belt safe (a standing-detection deck, an attendant), and
	  say so in the product's documentation. The source's
	  remote_motion_allowed() (safety key present, remote enabled at the
	  console) and the safety-key latch still apply either way.

# ── What the machine advertises ─────────────────────────────────────────────
#
# DERIVED, NOT DECLARED. The FTMS Target Setting bits and FE-C page 54's
# Simulation bit come from which source entry points are non-NULL
# (src/treadmill_caps.c); these switches can only take a capability AWAY, for a
# machine whose driver can move something the product does not want remote
# controllers to touch. A switch on for a NULL setter advertises nothing.

config TREADMILL_CAP_SPEED_TARGET
	bool "advertise speed control (FTMS Speed Target Setting) if the source can"
	default y
	help
	  FTMS Target Setting bit 0 and op code 0x02. Both go together: a
	  declared bit with a refused op code, or the reverse, makes a client
	  report the machine as broken.

config TREADMILL_CAP_INCLINE_TARGET
	bool "advertise incline control (FTMS Inclination Target, FE-C Simulation) if the source can"
	default y
	help
	  FTMS Target Setting bit 1 with op code 0x03, and FE-C page 54's
	  Simulation mode bit with page 51. With it off (or a NULL
	  set_incline) page 51 answers NOT_SUPPORTED and 0x03 answers 0x02.

# ── The machine's range ─────────────────────────────────────────────────────
#
# TRANSPORT-NEUTRAL, and that is the fix these exist for. Every command path is
# bounded by them - FE-C page 51, the FTMS control point and the BLE grade seam
# alike - in treadmill_state.c, so an FE-C-only build (no BLE at all) is held
# to the machine's real span rather than to the +-100 % the wire can carry.
# Any ANT+ transmitter in range can send page 51; it gets this range and no
# more.
#
# The split is by what the command MEANS (treadmill_state.h):
#   * a simulation grade (page 51, the grade seam) is a virtual road and is
#     CLAMPED to the range, answering PASS - the deck does the closest it can;
#   * an explicit FTMS Set Target Inclination / Speed is REFUSED out of range
#     (Invalid Parameter), target unchanged.
# With BLE on, the same values are what FTMS's Supported Speed and Supported
# Inclination Range characteristics advertise.
#
# SET THEM TO WHAT treadmill_source CAN ACTUALLY DO. A range wider than the
# deck gets the machine commanded into a span it then has to fail; the range
# must contain 0, which Reset and the FE-C "assume flat" sentinel command.

config TREADMILL_MAX_SPEED_CENTI_KPH
	int "maximum belt speed, 0.01 km/h"
	range 100 5758
	default 2000
	help
	  The fastest the belt may be commanded. 2000 is 20.00 km/h. Explicit
	  speed commands above it are refused. Also the Maximum field of FTMS's
	  Supported Speed Range when BLE is on.

	  The upper bound is 15996 mm/s (57.58 km/h), the most ANT+ SDM can
	  express; treadmill_state.c clamps there regardless.

config TREADMILL_MIN_INCLINE_DECI
	int "minimum grade, 0.1 %"
	range -1000 0
	default -30
	help
	  The lowest the deck may be commanded. -30 is -3.0 %, a typical
	  commercial decline. A simulation grade below it is clamped to it; an
	  explicit command below it is refused. Also the Minimum field of
	  FTMS's Supported Inclination Range when BLE is on.

config TREADMILL_MAX_INCLINE_DECI
	int "maximum grade, 0.1 %"
	range 0 1000
	default 150
	help
	  The highest the deck may be commanded. 150 is 15.0 %. Same clamp
	  and refusal split as the minimum.

# ── The BLE side ────────────────────────────────────────────────────────────

config TREADMILL_BLE
	bool "also advertise FTMS and RSC over BLE"
	depends on BT && BT_PERIPHERAL
	select BT_RSCS
	select BT_SMP
	# The shared BLE layer: advertising restart/backoff/watchdog, the
	# connection-parameter policy and DIS (radiant/src/ble).
	select RADIANT_BLE
	# The FTMS service is radiant's shared core (radiant_ble_ftms.h);
	# this application is its treadmill machine type.
	select RADIANT_BLE_FTMS
	select RADIANT_BLE_FTMS_TREADMILL
	#
	# SELECT, NOT DEPENDS, AND THE SYMBOL WAS CHECKED FIRST - the same
	# reasoning apps/hrm_ble/Kconfig records for HRM_BLE_HRS.
	# RADIANT_BACKEND_NRF_GATE_MPSL has NO `depends on` at all, so there is
	# nothing here for `select` to bypass.
	#
	# WHAT IT RETIRES. CONFIG_BT=y breaks the `!BT` half of the nrf
	# backend's `depends on !BT || RADIANT_BACKEND_NRF_GATE_MPSL`. Without
	# the gate the choice silently falls back to RADIANT_BACKEND_NULL - a
	# node that boots, logs "transmitting", and puts nothing on the air.
	# CMakeLists.txt carries a FATAL_ERROR backstop for the same interlock
	# approached from the other side.
	select RADIANT_BACKEND_NRF_GATE_MPSL
	#
	# PIN THE SOFTDEVICE CONTROLLER HERE, NOT ONLY IN A .conf FRAGMENT -
	# the same `select` apps/hrm_ble/Kconfig carries under HRM_BLE_HRS, and
	# it was simply missing here. Without it this application relies on
	# whatever the default link layer happens to be for CONFIG_BT=y on the
	# target board, which is a controller choice this design cannot leave to
	# chance: the MPSL gate this whole file exists to arbitrate assumes the
	# SDC, not the open-source LL, is what is beside radiant on the radio.
	#
	# LATENT RATHER THAN LIVE when it was added: the resolved .config for
	# tread_ble on nRF54L15 already read CONFIG_BT_LL_SOFTDEVICE=y, because
	# that is the default for this part. Which is exactly why it is worth
	# pinning - a default that happens to be right is not an interlock, and
	# the failure it would produce (radiant arbitrating against a controller
	# MPSL does not schedule) is the silent kind.
	select BT_LL_SOFTDEVICE
	help
	  FTMS (0x1826, hand-written - neither Zephyr nor NCS ships it) and RSC
	  (0x1814, NCS's bt_rscs_*), beside two ANT+ masters on one radio.

	  BT_SMP IS SELECTED AND IT IS NOT OPTIONAL DRESSING. FTMS Table 4.1
	  gives the Fitness Machine Control Point security permission
	  "Encryption", so the attribute carries BT_GATT_PERM_WRITE_ENCRYPT and
	  an unpaired client's write must fail. That means pairing, bonding and
	  key storage - an axis apps/hrm_ble does not have at all, since it
	  advertises an unencrypted HRS and never pairs.

	  THERE IS NO SUPPRESSION RULE HERE, and its absence is deliberate.
	  apps/hrm_ble stops ANT+ while a phone is connected, on the argument
	  that the phone already has the heart rate. That argument does not
	  transfer: a treadmill is expected to serve a head unit and a fitness
	  app at the same time, so the contended case is the NORMAL case here.

	  THAT RULING IS ABOUT THE TRANSMITTER AND STILL STANDS. It is not
	  about command ownership, which is a separate question and IS now
	  arbitrated - see TREADMILL_CTRL_POLICY below and
	  <radiant/radiant_ctrl_arbiter.h>. Nothing is ever suppressed: FE-C pages
	  16/17/19/80/81, SDM 0x7C and the FTMS Treadmill Data notification all
	  keep running for every listener no matter who holds control. What the
	  token decides is only whose commanded grade the deck actually moves
	  to, which would need deciding even if the two transports were on
	  separate chips. Reading the token as a reversal of the paragraph
	  above is the mistake it is worth one sentence to prevent.

config TREADMILL_BLE_ADV_INTERVAL_MS
	int "BLE advertising interval, milliseconds"
	depends on TREADMILL_BLE
	range 100 10000
	default 1000
	help
	  Carried over from apps/hrm_ble unchanged, and it is policy rather
	  than power tuning: MPSL ranks the Bluetooth controller above anything
	  an application can request, so RadiANT's share of the radio is
	  delivered by SHAPING BLE's demand. Shortening this is a decision to
	  take air away from two ANT+ masters.

	  The cost of the long interval is discovery latency, and it is
	  measured rather than estimated: at 1009 ms a scanner saw 18
	  advertisements in 120 s. Budget >= 90 s before calling a node
	  missing. See docs/hrm-reference-design.md section 7.

config TREADMILL_BLE_MIN_CONN_INTERVAL_UNITS
	int "shortest connection interval to accept, 1.25 ms units"
	depends on TREADMILL_BLE
	range 6 3200
	default 800
	help
	  800 units is 1 s, which is what nrf/samples/esb/esb_ptx_ble uses to
	  run BLE beside a timeslot user. A phone will ask for far less - iOS
	  asks for tens of milliseconds - and accepting hands the controller a
	  recurring high-priority event every few milliseconds for the life of
	  the connection.

	  Enforced by radiant/src/ble/radiant_ble_conn.c through
	  RADIANT_BLE_CONN_MIN_INTERVAL_UNITS, which defaults to this.

config TREADMILL_PAIRING_WINDOW_S
	int "pairing window opened by the console's pairing control, seconds"
	depends on TREADMILL_BLE && RADIANT_BLE_PAIRING_WINDOW
	range 10 600
	default 120
	help
	  How long radiant_ble_pairing_window_open() runs when the source
	  reports TREADMILL_EVT_PAIRING_WINDOW (the simulator: sw3). New
	  phones can bond only inside the window; bonded ones always
	  reconnect. TREADMILL_EVT_FORGET_BONDS clears every bond.

config TREADMILL_BLE_NOTIFY_INTERVAL_MS
	int "Treadmill Data notification interval, milliseconds"
	depends on TREADMILL_BLE
	range 200 5000
	default 1000
	help
	  FTMS says the server notifies Treadmill Data "at a regular interval,
	  typically once per second" and that the interval is NOT
	  client-configurable, so it is a build setting rather than a GATT one.

	  Every notification is radio time contending with two ANT+ masters
	  through the MPSL gate. 1000 ms is the spec's own typical value and
	  the one the coexistence gate should be run at.

# ── Command ownership ───────────────────────────────────────────────────────
#
# ONLY REACHABLE WITH BLE, because only then are there two controllers to
# arbitrate between. An FE-C-only build has exactly one command surface and a
# token would be ceremony; the gating code is compiled out entirely there
# rather than being present and always answering yes.
#
# NOT A SUPPRESSION RULE. See TREADMILL_BLE's help and <radiant/radiant_ctrl_arbiter.h>:
# every page and every notification keeps going out to every listener whoever
# holds the token. This decides only whose commanded grade the deck moves to.

choice TREADMILL_CTRL_POLICY
	prompt "command arbitration between FE-C and FTMS"
	depends on TREADMILL_BLE
	default TREADMILL_CTRL_POLICY_EXCLUSIVE
	help
	  What happens when a head unit on ANT+ and a phone on BLE both try to
	  command the machine. See <radiant/radiant_ctrl_arbiter.h>.

config TREADMILL_CTRL_POLICY_EXCLUSIVE
	bool "exclusive ownership - explicit beats implicit"
	select RADIANT_CTRL_ARBITER
	help
	  One controller at a time, and the asymmetry is spec-native rather
	  than invented: FTMS §4.16.2 already requires an explicit Request
	  Control (0x00) handshake and FE-C has no equivalent, so an explicit
	  claim preempts an implicit one and not the other way round.

	  A refused command is REFUSED ON THE WIRE, with a code that already
	  means this in each specification - page 71 status
	  RADIANT_PROFILE_FEC_CMD_STATUS_REJECTED (3) to an FE-C controller, result
	  code CONTROL_NOT_PERMITTED (0x05) to an FTMS client. Neither is
	  invented here, and silence would be worse than either: a controller
	  reports a machine that ignores commands as broken.

	  Pages that are not actuation stay ungated. Page 70 (Request Data
	  Page) and page 55 (User Configuration) are answered whoever holds the
	  token, because refusing a READ would make a machine look broken to a
	  head unit that is merely observing it.

config TREADMILL_CTRL_POLICY_NONE
	bool "none - last writer wins"
	help
	  The behaviour before the token existed, kept for an integrator who
	  wants it: both control paths apply their command unconditionally and
	  neither is ever told about the other.

	  IT IS NOT A SAFE DEFAULT AND IT IS NOT MEANT TO BE. Two controllers
	  writing the same setpoint with no signal to either produces a deck
	  oscillating between two grades while both ends report success, which
	  is invisible from either receiver. Choose it only when something
	  outside this node already guarantees a single commander.

endchoice

config TREADMILL_CTRL_ANT_TIMEOUT_MS
	int "release an idle ANT+ control claim after, milliseconds"
	depends on TREADMILL_CTRL_POLICY_EXCLUSIVE
	range 1000 600000
	default 30000
	help
	  ANT+ IS CONNECTIONLESS, so this is not a tuning knob - it is the only
	  release an implicit ANT claim has. A BLE client that walks away
	  generates a disconnect; an FE-C controller that walks away generates
	  nothing at all, it simply stops sending page 51. Without a timeout,
	  one page 51 early in a session would lock a phone out of the machine
	  until power cycle.

	  30 s is about 120 FE-C slots: long enough that a controller pausing
	  between commands keeps its claim, short enough that a user who
	  switches from a watch to a phone is not left waiting.

# ── Phase 5 ─────────────────────────────────────────────────────────────────

config TREADMILL_HR_RX
	bool "receive ANT+ heart rate from a chest strap"
	help
	  A THIRD ANT+ channel, this one a slave: device type 0x78, wildcard
	  device number. The bpm reaches FE-C page 16 byte 6 (with the
	  capabilities nibble's HR-source bits set to ANT+), the FTMS Treadmill
	  Data heart-rate field, and - when a console display exists - the
	  display. There is no display code in this tree and none is proposed.

	  IT ACQUIRES ONCE AND THEN STOPS SEARCHING. A tracking slave beside
	  two masters is the benign case; an acquisition SWEEP beside them is
	  what starves the arbiter, which is this project's own measurement and
	  the subject of ADR 0013. "Strongest wins" is implemented as a
	  proximity search floor that relaxes on timeout rather than as a
	  sweep - see src/treadmill_hr_rx.h for what that does and does not
	  guarantee.

	  Off by default: it is the third channel on a radio that is already
	  running two masters and possibly BLE, and it should be turned on
	  deliberately.

module = TREADMILL
module-str = treadmill
source "subsys/logging/Kconfig.template.log_config"

endif # TREADMILL
