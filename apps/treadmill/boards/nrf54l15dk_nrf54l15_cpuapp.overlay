/*
 * nRF54L15 DK, as a RadiANT treadmill.
 *
 * THE TARGET PART FOR THIS APPLICATION, and the only one it has been sized
 * against. docs/radiant-bridge.md section 11 rates the nRF52840 as "very
 * tight" for a full build; this application adds two hand-written GATT
 * services, SMP and a bonding store on top of the BLE second stack that
 * radiant/spike/mpsl_arb/README.md measured at +78.7 kB flash / +16.0 kB RAM,
 * and phase 5 adds a third ANT+ channel. Watch RAM specifically - the Matter
 * flash spike already established for this project that flash is not the wall,
 * RAM is.
 *
 * Deliberately NOT a copy of the dongle's overlay. That one's whole subject is
 * the ANT serial transport on the second VCOM; a treadmill has no transport at
 * all. It is fitness equipment: the only thing leaving the board over a wire is
 * the log on the console UART, which the board's own devicetree already
 * provides.
 *
 * What IS shared is the one line radiant's nrf backend cannot start without.
 */

/ {
	chosen {
		/*
		 * The TIMER the backend owns outright. It runs at 1 MHz forever
		 * and is what t_sync is hardware-captured into from RADIO's
		 * ADDRESS event, so it cannot be shared - naming it here rather
		 * than in the source is what makes a second user a devicetree
		 * conflict instead of two drivers reprogramming each other's
		 * prescaler.
		 *
		 * timer20 is free on this board, and is `status = "disabled"`
		 * by default like every TIMER on this SoC. An unclocked
		 * peripheral is not addressable, which the backend found once
		 * by taking a bus fault on its first register write.
		 *
		 * IT IS ALSO WHAT P0's TIMER AUDIT WAS ABOUT. mpsl.rst lists
		 * MPSL as owning TIMER10 *and* TIMER20 on nRF54L, while
		 * mpsl_hwres.h reserves only TIMER10. Measured: TIMER20 does not
		 * collide, and TIMER22 behaves identically. If a future MPSL
		 * revision does claim it, this is the line that moves.
		 */
		radiant,radio-timer = &timer20;
	};
};

&timer20 {
	status = "okay";
};
