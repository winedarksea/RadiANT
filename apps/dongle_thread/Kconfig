# CONFIG_RADIANT_ANTR_API and CONFIG_RADIANT_SEC_HOST_MESSAGES: the
# antr_* adapter's own symbols, shared with apps/dongle, apps/hrm_ble and
# radiant/tests/api the same way radiant/src/node/Kconfig and
# radiant/src/profiles/Kconfig already are. See apps/common/Kconfig.antr_api's
# header for why they live there and not in radiant/Kconfig.
rsource "../common/Kconfig.antr_api"

# CONFIG_ANT_DONGLE_MAIN and CONFIG_ANT_DONGLE_MAIN_BANNER: the boot sequence
# this application shares with apps/dongle. This application overrides the
# banner in its prj.conf and overrides the weak post-radio hook in src/main.c;
# everything else about booting is the same file.
rsource "../common/Kconfig.dongle_main"

# CONFIG_ANT_DONGLE_HEALTH_COUNTERS: the 0xF6 reply, shared with apps/dongle.
rsource "../common/Kconfig.health"

choice ANT_DONGLE_RADIO
	prompt "ANT radio backend"
	default ANT_DONGLE_RADIO_SDK_ANT
	help
	  Which implementation of apps/common/ant/ant_radio.h is compiled. All three
	  present the same antr_* contract, so the serial bridge and main() do
	  not know which is present - the same shape as the transport choice
	  above, and for the same reason.

	  Do not expect to set this here. Unlike the transport, this choice is
	  not actually decided by Kconfig: `list(APPEND ZEPHYR_EXTRA_MODULES)`
	  in CMakeLists.txt runs before find_package(Zephyr), therefore before
	  Kconfig exists, so a Kconfig symbol cannot decide whether sdk-ant's
	  Kconfig gets sourced. CMake decides from the ANT_RADIO cache variable
	  (-DANT_RADIO=sdk_ant|core|stub) and writes the answer back out as a
	  generated fragment which Zephyr merges last. This choice exists so
	  that .config records the decision.

	  THE P4 GATE ALWAYS PASSES -DANT_RADIO=core: the whole point of the
	  gate is measuring radiant's own arbitrated backend, and sdk-ant's
	  radio is Nordic's proprietary link layer with no arbiter hook at all.

config ANT_DONGLE_RADIO_SDK_ANT
	bool "Nordic's prebuilt ANT stack (sdk-ant)"
	help
	  Compile apps/common/ant_radio_sdk_ant.c. Needs an sdk-ant checkout;
	  see ANT_MODULE_DIR in apps/common/ant_radio_backend.cmake. Not what
	  the P4 gate builds against - see the choice's own help.

config ANT_DONGLE_RADIO_CORE
	bool "radiant, the clean-room stack"
	help
	  Compile radiant/, the open-source clean-room link layer, by setting
	  CONFIG_RADIANT=y on the Zephyr module of that name. The only backend
	  the P4 coexistence gate can measure, since it is the only one with an
	  MPSL arbitration hook (CONFIG_RADIANT_BACKEND_NRF_GATE_MPSL) at all.

config ANT_DONGLE_RADIO_STUB
	bool "Stub out the ANT radio layer"
	help
	  Compile apps/common/ant_radio_stub.c in place of a real ANT stack.
	  Every antr_*() entry point becomes a no-op returning success - useful
	  for bringing up the Thread/coexistence half of this image without a
	  working ANT build, but not a coexistence measurement of anything.

endchoice

config ANT_DONGLE_MSOS_DESCRIPTORS
	bool "Advertise WinUSB through MS OS descriptors"
	help
	  Emit the MS OS 1.0 and 2.0 descriptors that ask Windows to bind
	  winusb.sys automatically. See apps/dongle/Kconfig's own copy of this
	  symbol for the full rationale; off by default here for the same
	  reason.

config ANT_DONGLE_ENCRYPTION
	bool "Bridge the single channel encryption configuration messages"
	help
	  Implement MESG_ENCRYPT_ENABLE (0x7D), MESG_SET_ENCRYPT_KEY (0x7E) and
	  MESG_SET_ENCRYPT_INFO (0x7F). See apps/dongle/Kconfig's own copy of
	  this symbol for why it defaults off.

config ANT_DONGLE_UF2_SETTLE_MS
	int "Settling delay after a soft reset, before USB comes up (ms)"
	default 1000
	range 0 5000
	help
	  See apps/dongle/Kconfig's own copy of this symbol. None of this
	  application's P4 gate boards boot from a UF2 bootloader, so the delay
	  never actually fires there; it stays so a USB-capable board built
	  from this application behaves the same way apps/dongle's does.

config ANT_DONGLE_TX_POWER_BOOST
	bool "Transmit at the radio's maximum power by default"
	default y
	help
	  See apps/dongle/Kconfig's own copy of this symbol for the full
	  rationale. Left on by default for parity; the P4 gate's own conf
	  fragments do not touch it, so the bench measures the same transmit
