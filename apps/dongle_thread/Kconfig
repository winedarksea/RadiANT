# ── The P3/P4 coexistence bench instruments ─────────────────────────────────
#
# apps/dongle carries neither: it is ANT+-only, by design, and stripping
# every byte of a second wireless stack out of it entirely is the reason that
# application exists as a separate product rather than a Kconfig variant of
# this one. These two exist BECAUSE this application links a second stack -
# see thread_coex_load.c and ble_coex_load.c, both at this application's own
# root rather than under src/.

config ANT_DONGLE_BLE_COEX_LOAD
	bool "Start a BLE advertiser that competes with ANT+ for the radio"
	depends on BT && BT_BROADCASTER
	# Legal with the arbitrated backend, and legal with no real radio at all
	# (RADIANT_BACKEND=null), which is the configuration that isolates "is
	# this fault in the radio backend or in the application" - a question
	# that took a whole round to answer the slow way. It is ONLY forbidden
	# beside the DIRECT nrf backend, where two stacks would drive the RADIO
	# with no arbiter between them: not a coexistence measurement, a
	# collision.
	depends on !RADIANT_BACKEND_NRF || RADIANT_BACKEND_NRF_GATE_MPSL
	help
	  A bench instrument, not a feature. Brings the controller up and
	  advertises, so that the multiprotocol plan's P3 coexistence gate has a
	  second stack that actually WANTS the radio.

	  This exists because the obvious configuration does not test anything.
	  CONFIG_BT=y on its own links the SoftDevice Controller in and leaves it
	  asleep, asking MPSL for no air at all - measured, and it produced a
	  sweep-rate ratio of exactly 1.000 between "BLE off" and "BLE on"
	  builds, which is a gate that cannot fail.

	  It depends on the MPSL gate rather than merely coexisting with it: with
	  the direct gate the two stacks would both drive the RADIO with no
	  arbiter between them, which is not a coexistence measurement but a
	  collision.

	  Not apps/hrm_ble. That is a separate workstream with its own state
	  machine (SIG HRS beside ANT+ 0x78, ANT+ suppressed once a connection
	  is live); this advertises and nothing else, so that a loss figure
	  taken against it measures arbitration and not profile logic.

	  Off by default, and no shipping image selects it.

config ANT_DONGLE_BLE_COEX_LOAD_INTERVAL_MS
	int "BLE advertising interval for the coexistence load, ms"
	depends on ANT_DONGLE_BLE_COEX_LOAD
	range 20 10000
	default 100
	help
	  How often the advertiser asks for the air, and therefore how much of it
	  the second stack demands. An advertising event is three channels of
	  about 400 us plus ramp, so roughly 1.3 ms per interval: about 4 % of
	  the air at 30 ms and 0.4 % at 300 ms.

	  Configurable rather than fixed because the question the gate exists to
	  answer is not whether ANT+ survives one setting - it is where it stops
	  surviving, and a hard-coded number answers that once and then hides it.

	  100 ms is a common real-world connectable-advertising rate and sits in
	  the middle of that range.

config ANT_DONGLE_BLE_COEX_LOAD_DELAY_S
	int "Seconds after boot before the coexistence load starts"
	depends on ANT_DONGLE_BLE_COEX_LOAD
	range 0 600
	default 8
	help
	  The delay is an instrument rather than caution. Starting the controller
	  inside main() makes "ANT+ never worked" and "ANT+ stopped when BLE
	  started" the same observation, because both are true from the first
	  millisecond; with the load arriving seconds later the console shows the
	  sweep running, then the controller starting, and then whatever happens
	  next.

	  8 s is comfortably past enumeration and the host's channel setup. 0
	  starts it as early as the work queue runs.

config ANT_DONGLE_THREAD_COEX_LOAD
	bool "Attach to a Thread network and keep traffic on it"
	depends on NET_L2_OPENTHREAD && NET_SOCKETS
	# Identical reasoning to ANT_DONGLE_BLE_COEX_LOAD's second depends, and
	# for once it is not merely analogous: with the DIRECT nrf backend, the
	# 802.15.4 driver and radiant_radio_nrf.c would both drive the RADIO with
	# no arbiter between them. On nRF54L that is not even avoidable by
	# omission - enabling the 802.15.4 driver force-selects MPSL and
	# NRF_802154_MULTIPROTOCOL_SUPPORT through the nrfxlib Service Layer - so
	# the 15.4 side is arbitrated whatever this application does, and only
	# the ANT side's backend is still ours to get wrong.
	depends on !RADIANT_BACKEND_NRF || RADIANT_BACKEND_NRF_GATE_MPSL
	help
	  A bench instrument, not a feature. It is the P4 counterpart of
	  ANT_DONGLE_BLE_COEX_LOAD, and it exists for a sharper version of the
	  same reason.

	  CONFIG_NET_L2_OPENTHREAD=y on its own attaches a node and then, if it
	  is the sleepy role docs/radiant-bridge.md section 7.3b selects, goes
	  almost completely quiet - by design, because being quiet is what that
	  role is for. `ot state` says `child`, the node has an address, and it
	  has put four MLE frames on the air in the last minute. A gate measured
	  against that is the sweep-rate-ratio-of-1.000 failure again, except
	  harder to spot, because this time the second stack really is running.

	  So this sends datagrams on a timer and counts them, and the count is
	  part of the result: a P4 loss figure quoted without `sent` beside it is
	  not a measurement.

	  Off by default, and no shipping image selects it.
	  docs/decisions/0011-never-a-border-router.md is why none ever will.

config ANT_DONGLE_THREAD_COEX_LOAD_INTERVAL_MS
	int "Interval between coexistence datagrams, ms"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	range 10 10000
	default 100
	help
	  How often the Thread side asks for the air. 100 ms matches the BLE
	  load's default so the two gates are read at comparable demand.

	  Configurable for the reason the BLE interval is: the question is not
	  whether ANT+ survives one setting, it is where it stops surviving.

config ANT_DONGLE_THREAD_COEX_LOAD_PAYLOAD
	int "Coexistence datagram payload, bytes"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	range 1 800
	default 64
	help
	  Air time is roughly linear in this, and section 7.3a's two predictions
	  are quoted for full-size frames, so a run at the default is NOT
	  comparable to that number. Raise it toward a full 127-byte PSDU when
	  reproducing section 7.3a; leave it at 64 for a realistic sensor-chatter
	  load.

config ANT_DONGLE_THREAD_COEX_LOAD_DEST
	string "Coexistence datagram destination"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	default "ff03::1"
	help
	  Mesh-local all-nodes by default, and multicast rather than a unicast
	  peer on purpose: a unicast destination whose peer has rebooted or never
	  commissioned turns every send into an address-resolution failure, and
	  the board still puts a quite different amount of energy on the air than
	  the operator believes.

config ANT_DONGLE_THREAD_COEX_LOAD_PORT
	int "Coexistence datagram UDP port"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	range 1 65535
	default 4711

config ANT_DONGLE_THREAD_COEX_LOAD_DELAY_S
	int "Seconds after boot before the Thread coexistence load starts"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	range 0 600
	default 12
	help
	  Same instrument as the BLE load's delay, but longer: the BLE
	  advertiser is on the air the moment bt_enable() returns, while a
	  Thread node has to discover and attach first, and 8 s is not reliably
	  enough for that.

config ANT_DONGLE_THREAD_COEX_LOAD_REPORT_EVERY
	int "Log a load summary every N datagrams"
	depends on ANT_DONGLE_THREAD_COEX_LOAD
	range 1 100000
	default 100

# ── The RadiANT bridge: ANT+ in, Thread/MQTT/Matter out ─────────────────────
#
# docs/radiant-bridge.md. Everything here is off by default and none of it is
# compiled into the P4 gate arms: gate.conf, thread.conf and thread_sed.conf
# set none of these symbols, so the numbers in section 7.4 keep describing the
# image they were taken on. bridge.conf is where a bridge build turns them on.

config RADIANT_BRIDGE
	bool "Compile the RadiANT sample bus, binding table, rules and liveness"
	help
	  radiant/src/bridge/: the sample bus and sink registry (section 3-4),
	  the binding table (section 5), the rule evaluator (sections 6.1-6.2)
	  and the liveness table that produces RADIANT_SAMPLE_STALE (section
	  9.2). Plus src/bridge_pump.c, the thread that drains the bus - which
	  nothing in any image did before it existed.

	  This is the bus only. It ingests nothing on its own; that is
	  ANT_DONGLE_RX_TAP, and it publishes nowhere on its own; that is a
	  sink such as ANT_DONGLE_MQTT_SINK.

	  Turning this on adds the linker fragment
	  radiant/src/bridge/radiant_bridge_sections.ld through
	  zephyr_linker_sources(). That is not optional and its absence is
	  silent - see the fragment's own header, and watch for the
	  "bridge: N sinks" line at boot.

if RADIANT_BRIDGE

config ANT_DONGLE_BRIDGE_PUMP_MS
	int "Sample bus drain interval, ms"
	default 100
	range 10 1000
	help
	  How often src/bridge_pump.c calls radiant_bridge_drain(). The bus
	  ring holds 32 records; an 8-sensor deployment at 4 Hz producing up to
	  3 records each is ~96 records/s, so 100 ms is about a third of the
	  ring per pass and 300 ms would be the point at which a burst starts
	  evicting. radiant_bridge_stats().dropped is the number that says
	  whether this is too slow, and it is published on the bus itself.

config ANT_DONGLE_RX_TAP
	bool "Feed the sample bus from received ANT broadcasts"
	help
	  Compiles src/rx_tap.c and makes apps/common/ant_serial_bridge.c call
	  it at the top of antr_on_message(). The call site is compiled out
	  entirely without this symbol, which is what keeps apps/dongle's image
	  byte-identical and the `zero-cost` CI job meaningful.

	  The tap does not change what reaches a host. It reads a copy of each
	  broadcast, maps the channel to a bound source, and decodes; the frame
	  still goes out the transport unchanged.

	  A broadcast on a channel with no binding is DROPPED. That is section
	  10.1 rule 1 (no promiscuous ingest, ever) enforced in code, and there
	  is deliberately no path from the tap to radiant_binding_bind().

config ANT_DONGLE_SELF_CHANNELS
	int "Wildcard slave channels this dongle drives itself"
	default 0
	range 0 8
	depends on ANT_DONGLE_RX_TAP
	help
	  Compiles src/self_channels.c and opens this many wildcard ANT+
	  heart-rate slave channels without a host. A bridge that only works
	  while a PC is plugged in is not the product section 1 describes.

	  Channels are claimed from the top of the ANT allocation downward, so
	  that a host library allocating from 0 upward collides last. There is
	  no arbitration between the two - a host assign to a channel this file
	  holds open is refused CHANNEL_IN_WRONG_STATE - which is most of why
	  the default is 0.

	  Acquiring a device is NOT binding it. See ANT_DONGLE_PAIRING_WINDOW_S.

config ANT_DONGLE_SELF_CHANNELS_DELAY_S
	int "Seconds after boot before the self channels open"
	default 5
	range 1 600
	depends on ANT_DONGLE_SELF_CHANNELS > 0
	help
	  A real precondition rather than caution: ant_radio.h forbids any
	  antr_* call before antr_init() has returned, and src/self_channels.c
	  runs on its own thread rather than on the post-radio hook (which this
	  application's src/main.c already owns for the coexistence loads). The
	  boot sequence reaches antr_init() within the UF2 settle delay plus a
	  few milliseconds; 5 s is comfortably past it.

config ANT_DONGLE_PAIRING_WINDOW_S
	int "Seconds a button press keeps the pairing window open"
	default 60
	range 5 600
	depends on ANT_DONGLE_SELF_CHANNELS > 0
	help
	  Section 5 and section 10.1 rule 1: binding is explicit opt-in, never
	  promiscuous, and the document says the rule cannot be retrofitted.
	  So a press of sw0 opens this window, a device acquired on a self
	  channel may bind while it is open, and outside it an unbound device's
	  broadcasts are dropped.

	  A board with no sw0 alias can never open the window, and therefore
	  never binds anything. That is logged loudly at boot rather than
	  falling back to auto-binding, because the fallback would be exactly
	  the promiscuous ingest the rule forbids, arrived at through a board
	  file.

config ANT_DONGLE_PAIRING_WINDOW_AT_BOOT
	bool "BENCH ONLY: open the pairing window at boot, with no button press"
	depends on ANT_DONGLE_SELF_CHANNELS > 0
	help
	  A bench instrument, not a feature - the same shape and the same
	  posture as ANT_DONGLE_THREAD_COEX_LOAD. Off by default, selected by
	  no shipping image, and it logs a warning naming this symbol so a
	  console capture can never be mistaken for one from a normal build.

	  It exists because of a real gap in what can be tested. The liveness
	  STALE path is the one thing in the bridge that cannot be verified
	  without a binding; a binding needs the pairing window; and the window
	  needs a finger on sw0. That is correct for the product and is what
	  section 10.1 rule 1 requires - but it puts the single most important
	  bridge test out of reach of an automated bench, and an untested STALE
	  producer is indistinguishable from an absent one.

	  IT DOES NOT WEAKEN THE RULE IT WORKS AROUND. The window still opens
	  exactly once, still expires after ANT_DONGLE_PAIRING_WINDOW_S, and
	  still binds only devices acquired while it is open. What changes is
	  who opened it. The promiscuous ingest section 10.1 forbids is a
	  window that never closes, and this is not that.

	  If you are reading this in a build you did not make, the image was
	  built for a bench test and should not be shipped.

config ANT_DONGLE_MQTT_SINK
	bool "Publish samples to an MQTT broker over Thread"
	# NET_SOCKETS is deliberately NOT named here even though this sink
	# calls zsock_*: MQTT_LIB selects it, and MQTT_LIB is turned on below
	# by a `default y if` on this symbol, so naming it as a dependency here
	# closes the loop a second time (measured - it is the same rejection,
	# reported through a different chain).
	depends on NET_TCP && NET_IPV6
	help
	  Section 9. Plain MQTT over TCP to a broker on the Thread network -
	  not MQTT-SN, which section 9.0 rejects because it needs a gateway
	  daemon nothing in this path provides.

	  NEEDS CONFIG_NET_TCP, WHICH thread.conf DELIBERATELY OMITS. That is
	  why this lives in bridge.conf and the P4 gate arms stay TCP-free:
	  section 7.4's coexistence numbers were taken on a TCP-free image and
	  do not transfer to one with a TCP stack and a broker connection in
	  it. Do not fold the two fragments together.

	  The sink connects LAZILY, on the first sample it is asked to publish,
	  and never at boot. Do not "fix" that with CONFIG_NET_CONFIG_NEED_IPV6
	  - that is a 31.04 s pre-main() stall on an unattached MTD, measured
	  on this bench, and it looks exactly like a hung board.

config ANT_DONGLE_NAMING_DEBUG
	bool "Log the composed endpoint name for every field (bench instrument)"
	depends on RADIANT_BRIDGE
	help
	  A bench instrument, not a feature. Registers one extra sink that
	  logs what radiant_naming.c would call every distinct field it sees,
	  and shouts DUPLICATE NAME when two fields on one source compose to
	  the same string.

	  It exists because neither real consumer of that name is readable on
	  a bench: the Matter NodeLabel needs a commissioned controller and
	  the MQTT discovery payload needs a broker on a Thread network. With
	  this on, a plain bridge build and a real sensor answer the question
	  directly.

	  Defaults n, so it is absent from bridge.conf, matter.conf and all
	  five of docs/radiant-bridge.md section 7.4's coexistence arms - it
	  adds a sink, and those images' sink sets are asserted exactly in
	  .github/workflows/build.yml.

config ANT_DONGLE_MQTT_BROKER
	string "Broker address, as a numeric IPv6 literal"
	default "fd11:22::1"
	depends on ANT_DONGLE_MQTT_SINK
	help
	  A NUMERIC address, not a hostname: section 9.0a's DNS-SD discovery of
	  the broker rests on two things nobody has verified on real hardware
	  (whether HA's OTBR add-on enables the Discovery Proxy, and the
	  expectation that the Mosquitto add-on does not advertise _mqtt._tcp),
	  so it is deferred and there is no resolver call in this build at all.
	  An unparseable value here is logged as an error and the sink
	  publishes nothing.

	  The default is a placeholder in the OTBR ULA range and is certainly
	  not your broker.

config ANT_DONGLE_MQTT_PORT
	int "Broker port"
	default 1883
	range 1 65535
	depends on ANT_DONGLE_MQTT_SINK

config ANT_DONGLE_MQTT_BRIDGE_ID
	string "The <bridge_id> in every topic, and the MQTT client id"
	default "radiant0"
	depends on ANT_DONGLE_MQTT_SINK
	help
	  Section 9.1's topic tree hangs off this. Two bridges on one broker
	  with the same value would interleave their retained messages, so it
	  is per-unit in anything but a single-device bench.

	  Note what is NOT configurable: the per-sensor half of every topic is
	  the binding uuid, never a device number (section 5). A device number
	  is 16 bits, re-rollable by design, and collides across two straps in
	  one room.

config ANT_DONGLE_MATTER
	bool "Publish samples as Matter attributes over Thread"
	depends on CHIP
	help
	  Section 8.1 and package E of the Matter plan.
	  radiant/src/bridge/radiant_matter.c: the field-type -> cluster map,
	  the SI -> cluster unit conversion and the endpoint allocation, plus
	  the glue that turns radiant_matter_attr_write() from a __weak no-op
	  into a real attribute write.

	  DEPENDS ON CHIP RATHER THAN SELECTING IT, and the direction matters.
	  CONFIG_CHIP is set by nrf/sysbuild/CMakeLists.txt from
	  SB_CONFIG_MATTER, which is a SYSBUILD decision made outside this
	  Kconfig tree entirely and applied to the image afterwards. A `select`
	  here would claim an authority this symbol does not have, and would
	  produce the one thing worse than an image without Matter in it: a
	  .config that says Matter is present in an image where sysbuild
	  removed it. See apps/dongle_thread/matter_sysbuild.conf.

	  As of E3 this symbol turns on ANT_DONGLE_MATTER_MAP below, which
	  compiles radiant/src/bridge/radiant_matter.c, and CMakeLists.txt
	  compiles the vendored bridge core beside it. What it still does NOT do
	  is call a CHIP API from RadiANT: radiant_matter_attr_write() is a
	  __weak no-op until package E4 provides the data provider and E6 starts
	  the CHIP event loop. So this symbol being y does not yet mean anything
	  reaches a Matter controller.

	  The sink counter is how a running board answers the same question:
	  src/bridge_pump.c logs "bridge: N sinks" at boot, and N of 1 in a
	  Matter arm means only the MQTT sink linked and this one did not.

config ANT_DONGLE_MATTER_MAP
	bool "Compile radiant_matter.c, the field-type -> cluster map"
	default y if ANT_DONGLE_MATTER
	help
	  radiant/src/bridge/radiant_matter.c on its own, separately from
	  CONFIG_CHIP.

	  A SYMBOL OF ITS OWN RATHER THAN `depends on CHIP`, and the direction is
	  the point. That file contains no CHIP call and no CHIP include: it is
	  the section 8.1 vocabulary-type -> cluster table, the SI -> cluster unit
	  conversion, the endpoint allocation, and a __weak
	  radiant_matter_attr_write() that a real stack overrides. It compiles
	  identically in a workspace with no connectedhomeip in it. Gating it on
	  CONFIG_CHIP would make a pure-C lookup table unbuildable on the
	  Matterless nRF52840 escape hatch (docs/radiant-bridge.md section 11) for
	  no reason, and would tie a data decision to a build decision.

	  DEFAULT n EXCEPT ON THE MATTER ARM, and that is not caution either.
	  bridge.conf sets RADIANT_BRIDGE=y and carries one of the five
	  coexistence baselines in docs/radiant-bridge.md section 7.4. Defaulting
	  this on wherever the bus is present would put a second sink in that
	  image and move a number that is supposed to stay comparable. So it
	  follows ANT_DONGLE_MATTER, and the other four arms - where RADIANT_BRIDGE
	  itself is n - never see the symbol at all.

	  Note the consequence for the E2 regression diff: bridge.conf's generated
	  .config gains one `# CONFIG_ANT_DONGLE_MATTER_MAP is not set` COMMENT
	  line. Its image is unchanged.

config ANT_DONGLE_PROFILES_EXTRA
	bool "Decode more than heart rate: power, FE-C, environment, common pages"
	default y if ANT_DONGLE_MATTER
	help
	  The Matter plan's packages A, B and C, as one switch.

	  WHAT IT TURNS ON. Three more bridge adapters
	  (radiant_power_adapter.c, radiant_env_adapter.c,
	  radiant_common_adapter.c) and the four page codecs behind them
	  (profile_common.c, profile_power_decode.c, profile_fec.c,
	  profile_env.c), plus radiant/src/profiles on this application's
	  include path - see CMakeLists.txt, which is where the
	  profile_power_decode.c-not-profile_power.c split is argued. It also
	  turns on the two application-side halves that would otherwise have
	  nothing to feed:

	    src/rx_tap.c grows the ANT+ Common Data Pages Rev 3.1 Table 4-1
	    path (pages 0x40-0x5D, keyed on transmission type rather than on
	    device type, so it runs on EVERY bound channel) and the device-type
	    dispatch arms for 0x0B bicycle power, 0x11 fitness equipment and
	    0x19 environment. With this symbol n it is the 0x78-only tap it has
	    always been, byte for byte.

	    src/self_channels.c searches a five-row {device type, period} table
	    and rotates a row on every search timeout. With this symbol n both
	    self channels search device type 0x78 at period 8070 and set no
	    search timeout at all, which is exactly what they did before.

	  WHY THIS IS NOT SIMPLY IMPLIED BY RADIANT_BRIDGE, WHICH IS THE
	  QUESTION THE NEXT READER WILL ASK. bridge.conf sets RADIANT_BRIDGE=y
	  and IS ONE OF THE FIVE COEXISTENCE ARMS whose numbers are recorded in
	  docs/radiant-bridge.md section 7.4. Those numbers describe the images
	  they were taken on, and they are only comparable to each other while
	  the five images stay byte-identical - the same rule
	  ANT_DONGLE_MATTER_MAP above is defaulted n to protect.

	  Hanging these sources off RADIANT_BRIDGE directly broke that rule
	  twice over, and it was measured rather than argued
	  (docs/matter-e2-regression.md): +2 564 B of flash, +1 472 B of RAM and
	  22 new defined symbols on nrf54l15dk/nrf54l15/cpuapp. Worse than the
	  size, the rewritten self_channels.c changed WHAT THE RADIO DOES on
	  that arm - a rotating search over five device types at four different
	  channel periods instead of one fixed 0x78/8070 search - and section
	  7.4 is a measurement of exactly that. A coexistence baseline taken on
	  a different radio schedule is not a baseline.

	  So the sources follow ANT_DONGLE_MATTER, which only the Matter arm
	  sets, and bridge.conf is left alone. THE MATTER ARM THEREFORE NEEDS NO
	  LINE IN matter.conf: the `default y if ANT_DONGLE_MATTER` above is the
	  whole mechanism, and adding an explicit =y there would merely be a
	  second place to keep in step. The other four coexistence arms never
	  see the symbol at all, because RADIANT_BRIDGE is n in them.

	  Turning this on by hand on a bench build is entirely reasonable and is
	  what it is for - just do not turn it on in one of the five .conf
	  fragments without re-taking section 7.4's row for that arm.

	  Same consequence for the E2 diff as ANT_DONGLE_MATTER_MAP: bridge.conf's
	  generated .config gains one `# CONFIG_ANT_DONGLE_PROFILES_EXTRA is not
	  set` COMMENT line, and its image is unchanged.

endif # RADIANT_BRIDGE

# Turn the MQTT library on for a build that asked for the sink.
#
# `default`, NOT `select`, and this is the same trap the transport choice's
# help documents at length one screen up. `select MQTT_LIB` from a symbol that
# `depends on NET_SOCKETS` closes a Kconfig dependency loop, because
# MQTT_CLEAN_SESSION depends on MQTT_LIB, SETTINGS is implied through
# NRF_PROVISIONING's reverse dependencies, and NET_SOCKETS is reachable from
# COAP_SERVER on the other side of it. Kconfig rejects the whole file rather
# than any one line of it, and the reported loop runs through nRF Cloud
# provisioning, which has nothing to do with this. Measured: that is exactly
# what the first configure attempt of this file printed.
config MQTT_LIB
	default y if ANT_DONGLE_MQTT_SINK

endmenu

# The hostless node's identity and epoch (compat-C6), and the compatibility
# profiles' policy settings (compat-C7). Same wiring as apps/dongle/Kconfig -
# see that file's own comments for the full rationale; this application's
# epoch authority is still the PC behind it, not this Thread network.
rsource "../../radiant/src/node/Kconfig"
rsource "../../radiant/src/profiles/Kconfig"

# ── connectedhomeip's own Kconfig, for the Matter arm ───────────────────────
#
# CONFIG_CHIP itself needs none of this: connectedhomeip is a Zephyr module
# with `kconfig: config/nrfconnect/chip-module/Kconfig` in its module.yml, so
# the symbol is defined in every build of every application in this tree
# already, whether or not anyone wants Matter. What these three files carry is
# the DEFAULTS - and one of them is the trap.
#
# Kconfig.defaults is where `config BT / default y` lives. Not a line anybody
# writes: CONFIG_BT arrives in a Matter image as a Kconfig default, and it
# breaks the `!BT` half of radiant/Kconfig's `depends on !BT ||
# RADIANT_BACKEND_NRF_GATE_MPSL`, dropping the radio backend to NULL unless the
# Matter fragment names the gate. matter.conf names it, and says why at length.
# The point of sourcing this file rather than transcribing the dozen settings
# this arm happens to need is that the trap comes WITH the defaults; a
# hand-picked subset would omit it and the omission would look like safety.
#
# osource RATHER THAN source, on all three. These paths resolve through
# $(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR), which is empty in a workspace where
# connectedhomeip was never fetched - and this application must still configure
# there, because the Matterless MQTT build (docs/radiant-bridge.md section 11,
# the nRF52840 escape hatch) is a real target. `source` on a path that does not
# exist is a hard Kconfig error; `osource` is a no-op.
#
# WRAPPED IN `if CHIP`, and this is a decision rather than tidiness. Both
# connectedhomeip files are already `if CHIP` internally and are therefore
# inert on the other five arms whichever way this is written. NCS's
# samples/matter/common/src/Kconfig is NOT: it declares
# NCS_SAMPLE_MATTER_TEST_EVENT_TRIGGERS `default y` with no dependency at all,
# so sourced unconditionally it would appear as `=y` in gate.conf's,
# thread.conf's, thread_sed.conf's, coex.conf's and bridge.conf's generated
# .config - five coexistence baselines gaining a line each, for a symbol whose
# sources this application does not compile (NCS's source_common.cmake is
# inside `if(CONFIG_CHIP)`). Inert or not, a baseline that moves is a baseline
# that has to be re-argued. Inside `if CHIP` the symbols are still DEFINED
# everywhere - Kconfig's `if` adds a dependency, it does not hide a definition -
# so matter.conf can assign NCS_SAMPLE_MATTER_LEDS without the assignment
# becoming an undefined-symbol error, and the five other arms see only
# "# CONFIG_... is not set" comment lines.
if CHIP

osource "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
osource "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
osource "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"

# The vendored Matter bridge core's own symbols - BRIDGE_MAX_DYNAMIC_ENDPOINTS_
# NUMBER and its three companions, read BY NAME from bridge_manager.h and
# bridge_storage_manager.cpp. `rsource` rather than `osource` because unlike the
# three files above this one is in THIS repository and its absence would be a
# bug rather than a workspace without Matter fetched. It is inside `if CHIP`
# with them so that a non-Matter arm gains no symbols; see the block comment
# above, which applies unchanged.
rsource "src/matter/Kconfig"

endif # CHIP

source "Kconfig.zephyr"
