# Build outputs. `build*/` matches at any depth, so a stray in-tree build
# directory (apps/hrm_ble/build/ was one) is covered without a second rule.
# Note it would also match a future `builds/` or `build-tools/` directory --
# rename the rule rather than the directory if that ever comes up.
build*/
dist/
# Local FE-C test artifacts and firmware package.
archive/benchmarks/2026-10-19-fec/
# VCOM soak (TODO.md item 3): per-window logs/JSONs stay local, like the
# comparison below. Tracked: README, rig, summary, and the console capture of
# any window that a drop or reboot made worth keeping (named in the README).
archive/benchmarks/2026-11-07-vcom-soak/**
!archive/benchmarks/2026-11-07-vcom-soak/**/
!archive/benchmarks/2026-11-07-vcom-soak/**/README.md
!archive/benchmarks/2026-11-07-vcom-soak/**/rig.toml
!archive/benchmarks/2026-11-07-vcom-soak/**/summary.json
!archive/benchmarks/2026-11-07-vcom-soak/**/summary.md
!archive/benchmarks/2026-11-07-vcom-soak/S_multi_3_54L15_console.log

# Garmin comparison: ~760 per-window logs/JSONs stay local. Tracked: the
# README, each run's rig + summary (summary.json embeds every window's counts),
# and the device-number A/B's per-receiver results plus its script.
archive/benchmarks/2026-11-07-garmin-compare/**
!archive/benchmarks/2026-11-07-garmin-compare/**/
!archive/benchmarks/2026-11-07-garmin-compare/**/README.md
!archive/benchmarks/2026-11-07-garmin-compare/**/rig.toml
!archive/benchmarks/2026-11-07-garmin-compare/**/summary.json
!archive/benchmarks/2026-11-07-garmin-compare/**/summary.md
!archive/benchmarks/2026-11-07-garmin-compare/devnum-ab/diag_b.ps1
!archive/benchmarks/2026-11-07-garmin-compare/devnum-ab/*/*.json
archive/benchmarks/2026-11-14-garmin-compare/**
# Device-number RX loss (ADR 0019): ~720 per-window logs/JSONs stay local.
# Tracked: the README, the rig and analysis scripts, and windows.txt (every
# window's per-receiver counts plus the raw rxdiag captures).
archive/benchmarks/2026-11-07-devnum-rx-loss/*/
archive/benchmarks/2026-11-17-fec-crossing/**
!archive/benchmarks/2026-11-17-fec-crossing/README.md
# Every dated benchmark folder: raw per-leg output stays local and is
# regenerated with the folder's committed script; READMEs, scripts, rig files
# and summaries are tracked. `**/` also matches zero directories, so this
# covers each folder's own files and its nested window folders. Top-level
# archive/benchmarks/*.json baselines are not inside a dated folder and stay
# tracked. Do not force-add past these rules: archive/ has a 10 MB budget.
archive/benchmarks/20??-??-??-*/**/*.log
archive/benchmarks/20??-??-??-*/**/*.json
archive/benchmarks/20??-??-??-*/**/*.gz
archive/benchmarks/20??-??-??-*/**/*.out
archive/benchmarks/20??-??-??-*/**/*.err
archive/benchmarks/20??-??-??-*/**/*.hex
archive/benchmarks/20??-??-??-*/*/**/*.txt
!archive/benchmarks/20??-??-??-*/**/*summary*.json
!archive/benchmarks/20??-??-??-*/**/*summary*.txt
!archive/benchmarks/2026-11-13-inbound-burst-gaps/regression/*.txt
# Firmware images and their .config dumps rebuild from the commit and the
# .conf overlay named in the folder's README.
archive/benchmarks/20??-??-??-*/**/*.uf2
archive/benchmarks/20??-??-??-*/**/*.elf
archive/benchmarks/20??-??-??-*/**/*.zip
archive/benchmarks/20??-??-??-*/**/*.config
# Named evidence with no summary file to stand in for it (~77 KB in total).
!archive/benchmarks/2026-11-07-garmin-compare/devnum-ab/*/*.json
!archive/benchmarks/2026-11-07-vcom-soak/S_multi_3_54L15_console.log
# Re-stated after the summary exception above: this folder stays local whole.
archive/benchmarks/2026-11-14-garmin-compare/**
twister-out*/

# Tool caches. Each of these regenerates on demand; none is an input to
# anything. ruff.toml and .clang-tidy at the root are the tracked halves.
__pycache__/
.ruff_cache/
.pytest_cache/
.venv/

# Editor and agent state.
#
# .claude/ is deliberately NOT ignored wholesale: settings.json and any project
# skills there are shared configuration and belong in the tree. Only the
# per-machine halves are excluded.
.vscode/
.claude/settings.local.json
.claude/**/*.local.*

# Bench captures and console logs pulled off boards.
#
# PENDING A PRESERVATION DECISION -- see docs/preservation.md. bench-logs/p4/
# is 9.3 MB of primary records behind docs/radiant-bridge.md section 7.4.2, and
# archive/ has a CI-enforced 10 MB budget with ~2.7 MB already used, so these
# cannot simply move there. preservation.md's own rule for this case is a
# GitHub release asset referenced by SHA-256 from the relevant archive/README.
# Ignored here so the decision is made deliberately rather than by a commit.
bench-logs/
# The 2026-11-15 TI-over-shim Zwift capture (TODO.md cites it): 2.86 MB, six to
# eight times its committed siblings, so it stays local (owner, 2026-11-17).
captures/zwift-20261115-214118.pcap
tools/zwift_shim/out/
tools/zwift_shim/obj_a/
tools/zwift_shim/obj_b/
tools/zwift_shim/build.bat
